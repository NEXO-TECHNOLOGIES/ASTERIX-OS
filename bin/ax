    local script
    script=$(find_thunder_script "thunder.sh")
    if [ -n "$script" ]; then
        bash "$script" "$@"
    else
        echo -e "${C_RED}[!] THUNDER defender (thunder.sh) not found.${C_RESET}"
        echo -e "    Run ${C_YELLOW}ax pkg sync THUNDER${C_RESET} to download."
    fi
}

