cmd_os_computing() {
    local ax_root
    ax_root=$(find_asterix_root)
    local osc_dir=""
    if [ -n "$ax_root" ] && [ -d "${ax_root}/os-computing" ]; then
        osc_dir="${ax_root}/os-computing"
    elif [ -d "/etc/asterix/os-computing" ]; then
        osc_dir="/etc/asterix/os-computing"
    elif [ -d "os-computing" ]; then
        osc_dir="os-computing"
    elif [ -d "$HOME/asterix/os-computing" ]; then
        osc_dir="$HOME/asterix/os-computing"
    fi

    if [ -z "$osc_dir" ]; then
        echo -e "${C_RED}[!] Error: os-computing directory not located.${C_RESET}"
        return 1
    fi

    local py_cmd=""
    if [ -f "$HOME/.local/bin/python3.14.exe" ]; then
        py_cmd="$HOME/.local/bin/python3.14.exe"
    elif command -v python3.14 >/dev/null 2>&1; then
        py_cmd="python3.14"
    elif command -v python3 >/dev/null 2>&1 && python3 --version >/dev/null 2>&1; then
        py_cmd="python3"
    elif command -v py >/dev/null 2>&1 && py -3 --version >/dev/null 2>&1; then
        py_cmd="py -3"
    elif command -v python >/dev/null 2>&1 && python --version >/dev/null 2>&1; then
        py_cmd="python"
    fi

    if [ -n "$py_cmd" ] && [ -f "${osc_dir}/os_bridge.py" ]; then
        $py_cmd "${osc_dir}/os_bridge.py" "$@"
    elif [ -f "${osc_dir}/os_bridge.sh" ]; then
        bash "${osc_dir}/os_bridge.sh" "$@"
    else
        echo -e "${C_RED}[!] Error: Neither os_bridge.py nor os_bridge.sh found in ${osc_dir}.${C_RESET}"
        return 1
    fi
}

cmd_code_repair() {
    local action="${1:-scan}"
    local target="${2:-.}"
    if [ "$action" != "scan" ] && [ "$action" != "fix" ] && [ "$action" != "repair" ] && [ "$action" != "--fix" ]; then
        target="$action"
        action="scan"
    fi

    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX NATIVE CODE-REPAIR & HEALING SUITE...${C_RESET}\n"

    # 1. Try Native Pure-Rust engine
    if command -v asterix-code-repair >/dev/null 2>&1; then
        asterix-code-repair "$action" "$target"
        return $?
    elif [ -x "core-utils-rust/target/release/asterix-code-repair" ]; then
        core-utils-rust/target/release/asterix-code-repair "$action" "$target"
        return $?
    elif [ -x "/usr/local/bin/asterix-code-repair" ]; then
        /usr/local/bin/asterix-code-repair "$action" "$target"
        return $?
    fi

    # 2. Try Native C engine
    if command -v asterix-code-repair-c >/dev/null 2>&1; then
        asterix-code-repair-c "$action" "$target"
        return $?
    elif [ -x "core-utils-c/bin/asterix-code-repair" ]; then
        core-utils-c/bin/asterix-code-repair "$action" "$target"
        return $?
    fi

    # 3. Fallback to auto-compiler heuristic repair
    if [ -f "auto-compiler/autocompile.py" ] && command -v python3 >/dev/null 2>&1 && python3 --version >/dev/null 2>&1; then
        python3 auto-compiler/autocompile.py "$target"
    elif [ -f "auto-compiler/autocompile.sh" ]; then
        bash auto-compiler/autocompile.sh "$target"
    else
        echo -e "${C_YELLOW}[!] Running native Rust engine via cargo...${C_RESET}"
        if command -v cargo >/dev/null 2>&1; then
            cargo run --manifest-path core-utils-rust/asterix-code-repair/Cargo.toml --release -- "$action" "$target"
        else
            echo -e "${C_RED}[!] No code repair compiler runtime available.${C_RESET}"
            return 1
        fi
    fi
}

resolve_asterix_python() {
    if [ -f "$HOME/.local/bin/python3.14.exe" ]; then
        echo "$HOME/.local/bin/python3.14.exe"
    elif [ -f "C:/Users/Baha/.local/bin/python3.14.exe" ]; then
        echo "C:/Users/Baha/.local/bin/python3.14.exe"
    elif command -v python3.14 >/dev/null 2>&1; then
        echo "python3.14"
    elif command -v python3 >/dev/null 2>&1 && python3 --version >/dev/null 2>&1; then
        echo "python3"
    elif command -v python >/dev/null 2>&1 && python --version >/dev/null 2>&1; then
        echo "python"
    elif command -v py >/dev/null 2>&1 && py -3 --version >/dev/null 2>&1; then
        echo "py -3"
    else
        echo ""
    fi
}

cmd_code_healer() {
    local py; py=$(resolve_asterix_python)
    local ax_root; ax_root=$(find_asterix_root)
    local script="${ax_root}/asterix-ai/code_healer.py"
    [ -f "$script" ] || script="asterix-ai/code_healer.py"
    if [ -n "$py" ] && [ -f "$script" ]; then
        $py "$script" "$@"
    else
        echo -e "${C_RED}[!] Error: Python runtime or code_healer.py not found.${C_RESET}"
        return 1
