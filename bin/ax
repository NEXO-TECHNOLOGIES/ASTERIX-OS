cmd_loot() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX Persistent Loot & Intelligence Vault:${C_RESET}\n"
    local vault_dir="/asterix_persistent/loot"
    [ -d "$vault_dir" ] || vault_dir="${HOME}/asterix_persistent/loot"
    [ -d "$vault_dir" ] || vault_dir="${HOME}/asterix_reports"

    if [ -d "$vault_dir" ]; then
        echo -e "${C_YELLOW}Location: ${vault_dir}${C_RESET}\n"
        ls -la "$vault_dir"
    else
        echo -e "${C_GRAY}[i] No loot directory found. Loot is automatically collected during scans.${C_RESET}"
    fi
}

