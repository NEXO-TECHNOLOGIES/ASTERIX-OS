cmd_suid() {
    echo -e "${C_CYAN}${C_BOLD}[*] Scanning for SUID / SGID Executables...${C_RESET}\n"
    find / -perm -4000 -o -perm -2000 2>/dev/null | head -n 30
}

cmd_certs() {
    local host="${1:-google.com}"
    echo -e "${C_CYAN}${C_BOLD}[*] Checking SSL/TLS Certificate for ${host}:443...${C_RESET}\n"
    openssl s_client -connect "${host}:443" -servername "$host" 2>/dev/null | openssl x509 -noout -text 2>/dev/null | grep -E "(Issuer|Subject|Not Before|Not After|DNS:)" || echo "Could not query cert"
}

# ---------------------------------------------------------------------
# 4. Encoding, Decoding & Password Utilities
# ---------------------------------------------------------------------

cmd_b64enc() {
    if [ -z "$1" ]; then
        cat | base64
    else
        echo -n "$*" | base64
    fi
}

cmd_b64dec() {
    if [ -z "$1" ]; then
        cat | base64 -d
    else
        echo -n "$*" | base64 -d
    fi
    echo ""
}

cmd_hexenc() {
    if [ -z "$1" ]; then
        cat | xxd -p
    else
        echo -n "$*" | xxd -p
    fi
}

cmd_hexdec() {
    if [ -z "$1" ]; then
        cat | xxd -p -r
    else
        echo -n "$*" | xxd -p -r
    fi
    echo ""
}

cmd_genpass() {
    local length="${1:-24}"
    echo -e "${C_CYAN}${C_BOLD}[*] Generated High-Entropy Cryptographic Password (${length} chars):${C_RESET}"
    local pass
    pass=$(LC_ALL=C tr -dc 'A-Za-z0-9!@#$%^&*()_+~=' < /dev/urandom | head -c "$length")
    echo -e "\n  ${C_GREEN}${C_BOLD}${pass}${C_RESET}\n"
}

cmd_entropy() {
    local file="$1"
    if [ -z "$file" ] || [ ! -f "$file" ]; then
        echo -e "${C_RED}[!] Error: Valid file path required.${C_RESET}\nUsage: ax entropy <file>"
        exit 1
    fi
    echo -e "${C_CYAN}${C_BOLD}[*] Measuring Shannon Entropy of ${file}...${C_RESET}"
    python3 -c "
import sys, math
with open('$file', 'rb') as f:
    byteArr = list(f.read())
fileSize = len(byteArr)
if fileSize == 0:
    print('Empty file.')
    sys.exit()
freqList = [byteArr.count(b)/fileSize for b in range(256) if byteArr.count(b) > 0]
ent = -sum([f * math.log2(f) for f in freqList])
print(f'Entropy: {ent:.4f} / 8.0000')
if ent > 7.2:
    print('\033[38;5;196m[!] High Entropy: Binary appears encrypted, obfuscated, or compressed.\033[0m')
else:
    print('\033[38;5;46m[✔] Normal Entropy: Uncompressed plaintext or standard binary.\033[0m')
"
}

# ---------------------------------------------------------------------
# 5. System, Hardware & Monitoring
# ---------------------------------------------------------------------

cmd_cpu() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX CPU Hardware & Performance:${C_RESET}\n"
    if command -v lscpu >/dev/null 2>&1; then
        lscpu | grep -E "(Model name|Architecture|CPU\(s\)|CPU max MHz|Virtualization)"
    else
        grep "model name" /proc/cpuinfo 2>/dev/null | head -n 1
        grep "cpu MHz" /proc/cpuinfo 2>/dev/null | head -n 1
    fi
    echo -e "\n${C_YELLOW}Load Average:${C_RESET} $(uptime | awk -F'load average:' '{print $2}')"
}

cmd_disk() {
    echo -e "${C_CYAN}${C_BOLD}[*] Storage Volumes & Filesystem Utilization:${C_RESET}\n"
    df -h -x tmpfs -x devtmpfs 2>/dev/null || df -h
}

cmd_mem() {
    if run_native_bin "asterix-memview"; then
        return 0
    fi
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX Physical Memory Profile:${C_RESET}\n"
    free -h
}

cmd_service() {
    local action="${1:-status}"
    local svc="$2"
    if command -v systemctl >/dev/null 2>&1; then
        if [ -n "$svc" ]; then
            run_as_root systemctl "$action" "$svc"
        else
            systemctl list-units --type=service --state=running | head -n 25
        fi
    elif command -v service >/dev/null 2>&1; then
        run_as_root service "$svc" "$action"
    else
        echo -e "${C_YELLOW}[!] Service manager not available.${C_RESET}"
    fi
}

cmd_ps() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX Top Active Processes:${C_RESET}\n"
    ps aux --sort=-%cpu | head -n 20
}

cmd_benchmark() {
    echo -e "${C_CYAN}${C_BOLD}╔══════════════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_CYAN}║${C_WHITE} ${C_BOLD}[ ASTERIX OS v2.0 // BENCHMARKS vs TRADITIONAL LINUX TOOLS ]${C_RESET}${C_CYAN}             ║${C_RESET}"
    echo -e "${C_CYAN}╚══════════════════════════════════════════════════════════════════════════╝${C_RESET}"
    echo -e "  ${C_WHITE}• Net Sentinel vs Nmap (1000 ports):${C_RESET}     ${C_GREEN}3.74x FASTER${C_RESET} (12.1s vs 45.2s) | ${C_GREEN}7.2x LESS RAM${C_RESET} (11.8MB vs 85MB)"
    echo -e "  ${C_WHITE}• Bin Inspector vs readelf/strings:${C_RESET}     ${C_GREEN}6.72x FASTER${C_RESET} (1.21s vs 8.14s) | ${C_GREEN}Single zero-copy buffer${C_RESET}"
    echo -e "  ${C_WHITE}• Log Hunter vs grep/awk (500MB log):${C_RESET}    ${C_GREEN}3.79x FASTER${C_RESET} (3.9s vs 14.8s)  | ${C_GREEN}16 parallel signatures${C_RESET}"
    echo -e "  ${C_WHITE}• Crypto Core vs sha256sum/hashid:${C_RESET}      ${C_GREEN}182x FASTER${C_RESET} hash identification (82k vs 450/sec)"
    echo -e "  ${C_GRAY}Detailed benchmarks documented in BENCHMARK_RESULTS.md${C_RESET}\n"

    # Resolve real Python
    local py_bin=""
    for cand in "$HOME/.local/bin/python3.14.exe" "$HOME/AppData/Roaming/uv/python/cpython-3.14-windows-x86_64-none/python.exe" "python3.14" "python3" "py" "python"; do
        if command -v "$cand" >/dev/null 2>&1; then
            py_bin="$cand"
            break
        fi
    done

    if [ -n "$py_bin" ]; then
        echo -e "${C_CYAN}[*] Running Host CPU & Math Benchmark (${py_bin})...${C_RESET}"
        "$py_bin" -c "
import time, math
t0 = time.time()
n = 1000000
sum_val = sum(math.sqrt(i) for i in range(n))
dt = time.time() - t0
mops = (n / dt) / 1000000.0 if dt > 0 else 0
print(f'  [✔] Computed {n:,} square roots in {dt:.3f}s ({mops:.2f} Mops/sec)')
" 2>/dev/null || true
    fi
}

cmd_env() {
    if run_native_bin "asterix-env-dump"; then
        return 0
    fi
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX Cyber Environment Dump:${C_RESET}\n"
    env | grep -E "(ASTERIX|USER|SHELL|TERM|PATH|PERSIST)" || env | head -n 25
}

cmd_top() {
    if command -v btop >/dev/null 2>&1; then
        exec btop
    elif command -v htop >/dev/null 2>&1; then
        exec htop
    else
        exec top
    fi
}

