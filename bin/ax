    local quotes=(
        "\"The sky above the port was the color of television, tuned to a dead channel.\" — William Gibson, Neuromancer"
        "\"We operate in the shadows to serve the light. Cyberspace is the new frontier of sovereignty.\" — ASTERIX OS Core"
        "\"Information wants to be free. Information also wants to be expensive.\" — Stewart Brand"
        "\"Technology is not good nor bad; nor is it neutral.\" — Melvin Kranzberg"
        "\"If you think cryptography is the solution to your problem, then you don't know what your problem is.\" — Peter G. Neumann"
        "\"Hardware eventually fails. Software eventually works. Cybernetics bridges the void.\" — Cybernetic Manifesto"
        "\"No system is safe. There are only systems that haven't encountered us yet.\" — Hacker Ethos"
        "\"In the empire of code, the one who audits the memory controls the reality.\" — ASTERIX OS"
    )
    local idx=$((RANDOM % ${#quotes[@]}))
    echo -e "${C_PURPLE}${C_BOLD}🌌 ASTERIX CYBERNETIC ETHOS:${C_RESET}"
    echo -e "${C_CYAN}${quotes[$idx]}${C_RESET}\n"
}

cmd_encrypt() {
    local file="$1"
    if [ -z "$file" ] || [ ! -f "$file" ]; then
        echo -e "${C_RED}[!] Error: File to encrypt not found.${C_RESET}\nUsage: ax encrypt <file>"
        exit 1
    fi
    local out="${file}.axenc"
    echo -e "${C_CYAN}[*] Encrypting ${file} -> ${out} with AES-256-CBC (PBKDF2)...${C_RESET}"
    openssl enc -aes-256-cbc -pbkdf2 -salt -in "$file" -out "$out"
    echo -e "${C_GREEN}[✔] File encrypted: ${out}${C_RESET}"
}

cmd_decrypt() {
    local file="$1"
    if [ -z "$file" ] || [ ! -f "$file" ]; then
        echo -e "${C_RED}[!] Error: File to decrypt not found.${C_RESET}\nUsage: ax decrypt <file.axenc>"
        exit 1
    fi
    local out="${file%.axenc}"
    [ "$out" = "$file" ] && out="${file}.dec"
    echo -e "${C_CYAN}[*] Decrypting ${file} -> ${out}...${C_RESET}"
    openssl enc -d -aes-256-cbc -pbkdf2 -in "$file" -out "$out"
    echo -e "${C_GREEN}[✔] Decrypted successfully: ${out}${C_RESET}"
}

cmd_sniff_live() {
    local iface="${1:-any}"
    local filter="${2:-}"
    echo -e "${C_RED}${C_BOLD}[*] LAUNCHING LIVE PACKET RADAR ON INTERFACE: ${C_WHITE}${iface}${C_RESET}\n"
    if command -v tcpdump >/dev/null 2>&1; then
        run_as_root tcpdump -i "$iface" -n -c 50 "$filter" 2>/dev/null || echo "Capture terminated."
    else
        echo -e "${C_RED}[!] tcpdump is required for live packet sniffing (ax install tcpdump).${C_RESET}"
    fi
}

cmd_sysfetch() {
    local host
    host=$(hostname 2>/dev/null || echo "asterix-node")
    local kern
    kern=$(uname -r 2>/dev/null || echo "cyber-kernel")
    local arch
    arch=$(uname -m 2>/dev/null || echo "x86_64")
    local uptime
    uptime=$(uptime -p 2>/dev/null || uptime | awk '{print $3,$4}' || echo "active")
    local mem
    mem=$(free -m 2>/dev/null | awk '/Mem:/ {print $3 "MB / " $2 "MB"}' || echo "N/A")
    local shell_name
    shell_name="${SHELL:-/bin/bash}"
    
    echo -e "${C_CYAN}${C_BOLD}"
    cat << 'EOF'
     ___       _______.___________.___________.  _______.    ______      _______.
    /   \     /       |           |           | /       |   /  __  \    /       |
   /  ^  \   |   (----`---|  |----`---|  |----`|   (----`  |  |  |  |  |   (----`
  /  /_\  \   \   \       |  |        |  |      \   \      |  |  |  |   \   \    
 /  _____  \ .----)   |   |  |        |  |  .----)   |     |  `--'  |.----)   |   
/__/     \__\|_______/    |__|        |__|  |_______/       \______/ |_______/    
EOF
    echo -e "${C_MAGENTA}${C_BOLD}   :: ASTERIX OS CYBERNETIC OPERATING ENVIRONMENT ::${C_RESET}\n"
    echo -e "   ${C_CYAN}OS:${C_RESET}      ASTERIX OS Cybernetic Linux (${VERSION})"
    echo -e "   ${C_CYAN}Host:${C_RESET}    ${host}"
    echo -e "   ${C_CYAN}Kernel:${C_RESET}  ${kern} (${arch})"
    echo -e "   ${C_CYAN}Uptime:${C_RESET}  ${uptime}"
    echo -e "   ${C_CYAN}Memory:${C_RESET}  ${mem}"
    echo -e "   ${C_CYAN}Shell:${C_RESET}   ${shell_name}"
    echo -e "   ${C_CYAN}Engine:${C_RESET}  Rust UI Core + C/C++ Hyper-Kernels + Shell Arsenal"
    echo -e "   ${C_CYAN}Status:${C_RESET}  ${C_GREEN}ALL SUBSYSTEMS NOMINAL${C_RESET}\n"
    echo -e "   \033[48;5;196m   \033[48;5;208m   \033[48;5;220m   \033[48;5;46m   \033[48;5;51m   \033[48;5;45m   \033[48;5;201m   \033[0m\n"
}

# ---------------------------------------------------------------------
# 9. Advanced Defensive Hardening, FIM, SIEM & Compliance Suites
# ---------------------------------------------------------------------

cmd_kernel_hardening() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX LINUX KERNEL SECURITY & HARDENING AUDIT...${C_RESET}\n"
    local score=0
    local total=8

    check_sysctl() {
        local param="$1"
        local expected="$2"
        local desc="$3"
        local val
        val=$(sysctl -n "$param" 2>/dev/null || echo "N/A")
        if [ "$val" = "$expected" ]; then
            echo -e "  ${C_GREEN}[PASS]${C_RESET} ${param} = ${val} (${desc})"
            score=$((score + 1))
        else
            echo -e "  ${C_RED}[WARN]${C_RESET} ${param} = ${val} (Expected: ${expected} - ${desc})"
        fi
    }

    check_sysctl "kernel.randomize_va_space" "2" "Full ASLR protection"
    check_sysctl "kernel.yama.ptrace_scope" "1" "Ptrace scope restricted"
    check_sysctl "net.ipv4.tcp_syncookies" "1" "SYN flood protection enabled"
    check_sysctl "net.ipv4.conf.all.accept_redirects" "0" "Ignore ICMP redirects"
    check_sysctl "net.ipv4.conf.all.send_redirects" "0" "Do not send ICMP redirects"
    check_sysctl "net.ipv4.conf.all.rp_filter" "1" "Reverse path IP spoof filtering"
    check_sysctl "kernel.dmesg_restrict" "1" "Restrict unprivileged dmesg access"
    check_sysctl "kernel.kptr_restrict" "2" "Hide kernel pointer addresses"

    local pct=$((score * 100 / total))
    echo -e "\n${C_BOLD}Kernel Hardening Score: ${C_YELLOW}${pct}%${C_RESET} (${score}/${total} controls passing)\n"
}

cmd_fim_init() {
    local db="/var/log/asterix-fim.db"
    [ -w "/var/log" ] || db="./loot/fim.db"
    mkdir -p "$(dirname "$db")" 2>/dev/null || true
    echo -e "${C_CYAN}${C_BOLD}[*] INITIALIZING FILE INTEGRITY MONITORING (FIM) BASELINE...${C_RESET}"
    echo -e "${C_GRAY}Target baseline store: ${db}${C_RESET}\n"

    local targets=("/etc/passwd" "/etc/shadow" "/etc/group" "/etc/sudoers" "/etc/ssh/sshd_config" "/etc/pam.d" "/etc/crontab" "/bin/bash" "/usr/bin/sudo" "/bin/login")
    > "$db"

    for t in "${targets[@]}"; do
        if [ -f "$t" ]; then
            sha256sum "$t" 2>/dev/null >> "$db" || true
        elif [ -d "$t" ]; then
            find "$t" -type f -exec sha256sum {} + 2>/dev/null >> "$db" || true
        fi
    done

    local count
    count=$(wc -l < "$db" 2>/dev/null || echo 0)
    echo -e "${C_GREEN}[✔] Baseline recorded for ${count} critical system files.${C_RESET}\n"
}

cmd_fim_check() {
    local db="/var/log/asterix-fim.db"
    [ -f "$db" ] || db="./loot/fim.db"
    if [ ! -f "$db" ]; then
        echo -e "${C_RED}[!] Error: FIM baseline not found. Run 'ax fim-init' first.${C_RESET}"
        return 1
    fi

    echo -e "${C_CYAN}${C_BOLD}[*] VERIFYING FILE INTEGRITY AGAINST BASELINE (${db})...${C_RESET}\n"
    local mismatches=0
    while read -r expected_hash filepath; do
        if [ ! -f "$filepath" ]; then
            echo -e "  ${C_RED}[MISSING]${C_RESET} File removed: ${filepath}"
            mismatches=$((mismatches + 1))
            continue
        fi
        local current_hash
        current_hash=$(sha256sum "$filepath" 2>/dev/null | awk '{print $1}')
        if [ "$current_hash" != "$expected_hash" ]; then
            echo -e "  ${C_RED}[MODIFIED]${C_RESET} Checksum altered: ${filepath}"
            mismatches=$((mismatches + 1))
        fi
    done < "$db"

    if [ "$mismatches" -eq 0 ]; then
        echo -e "${C_GREEN}[✔] All monitored system files match cryptographic baseline. Zero tampering detected.${C_RESET}\n"
    else
        echo -e "\n${C_RED}${C_BOLD}[ALERT] ${mismatches} integrity violation(s) identified!${C_RESET}\n"
    fi
}

cmd_auth_audit() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX AUTHENTICATION & INTRUSION ANOMALY AUDIT...${C_RESET}\n"
    local logfile=""
    for cand in "/var/log/auth.log" "/var/log/secure" "/var/log/messages"; do
        if [ -r "$cand" ]; then logfile="$cand"; break; fi
    done

    if [ -z "$logfile" ]; then
        if command -v journalctl >/dev/null 2>&1; then
            echo -e "${C_YELLOW}[*] Querying systemd journal for authentication events...${C_RESET}"
            journalctl -u ssh -u sshd -n 50 --no-pager 2>/dev/null || true
            return 0
        fi
        echo -e "${C_YELLOW}[!] Auth log not readable directly. Try with sudo or check journalctl.${C_RESET}"
        return 0
    fi

    echo -e "${C_WHITE}${C_BOLD}Top 5 Attacking IP Addresses (Failed Passwords):${C_RESET}"
    grep "Failed password" "$logfile" 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | sort | uniq -c | sort -nr | head -n 5 || echo "  No failed password events."

    echo -e "\n${C_WHITE}${C_BOLD}Recent Successful Sudo Invocations:${C_RESET}"
    grep "COMMAND=" "$logfile" 2>/dev/null | tail -n 8 || echo "  No recent sudo events."

    echo -e "\n${C_WHITE}${C_BOLD}Recent Root Login Attempts:${C_RESET}"
    grep -i "root" "$logfile" 2>/dev/null | grep -iE 'accepted|failed|session opened' | tail -n 5 || echo "  None detected."
    echo ""
}

cmd_git_secrets() {
    local target_dir="${1:-.}"
    echo -e "${C_CYAN}${C_BOLD}[*] AUDITING REPOSITORY FOR SENSITIVE SECRETS & LEAKED KEYS in: ${C_WHITE}${target_dir}${C_RESET}\n"

    local hits=0
    local pkeys
    pkeys=$(grep -rnEI "BEGIN (RSA|OPENSSH|DSA|EC) PRIVATE KEY" "$target_dir" --exclude-dir=".git" 2>/dev/null | head -n 5 || true)
    if [ -n "$pkeys" ]; then
        echo -e "  ${C_RED}[ALERT] Discovered Private Keys:${C_RESET}\n$pkeys\n"
        hits=$((hits + 1))
    fi

    local aws
    aws=$(grep -rnEI "AKIA[0-9A-Z]{16}" "$target_dir" --exclude-dir=".git" 2>/dev/null | head -n 5 || true)
    if [ -n "$aws" ]; then
        echo -e "  ${C_RED}[ALERT] Discovered AWS Access Key ID:${C_RESET}\n$aws\n"
        hits=$((hits + 1))
    fi

    local apikeys
    apikeys=$(grep -rnEI "(api_key|apikey|secret_key|client_secret)\s*[:=]\s*['\"][0-9a-zA-Z_\-]{16,}['\"]" "$target_dir" --exclude-dir=".git" 2>/dev/null | head -n 5 || true)
    if [ -n "$apikeys" ]; then
        echo -e "  ${C_YELLOW}[!] Potential Hardcoded API Secrets:${C_RESET}\n$apikeys\n"
        hits=$((hits + 1))
    fi

    local sens_files
    sens_files=$(find "$target_dir" \( -name ".env" -o -name "id_rsa" -o -name "*.pem" -o -name "*.key" \) -not -path "*/.git/*" 2>/dev/null | head -n 10 || true)
    if [ -n "$sens_files" ]; then
        echo -e "  ${C_YELLOW}[!] Sensitive Credential Files Located:${C_RESET}\n$sens_files\n"
        hits=$((hits + 1))
    fi

    if [ "$hits" -eq 0 ]; then
        echo -e "${C_GREEN}[✔] No critical credential leaks or uncommitted keys detected.${C_RESET}\n"
    fi
}

cmd_cis_audit() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX CIS LINUX BENCHMARK SECURITY COMPLIANCE AUDIT...${C_RESET}\n"

    if [ -f "/etc/shadow" ]; then
        local shadow_perm
        shadow_perm=$(stat -c "%a" /etc/shadow 2>/dev/null || stat -f "%Op" /etc/shadow 2>/dev/null || echo "unknown")
        if [ "$shadow_perm" = "0" ] || [ "$shadow_perm" = "640" ] || [ "$shadow_perm" = "0000" ]; then
            echo -e "  ${C_GREEN}[PASS]${C_RESET} /etc/shadow permissions: ${shadow_perm}"
        else
            echo -e "  ${C_YELLOW}[WARN]${C_RESET} /etc/shadow permissions too permissive: ${shadow_perm} (recommend 0000 or 0640)"
        fi
    fi

    if [ -r "/etc/shadow" ]; then
        local empty_pass
        empty_pass=$(awk -F: '($2 == "" ) { print $1 }' /etc/shadow 2>/dev/null || true)
        if [ -z "$empty_pass" ]; then
            echo -e "  ${C_GREEN}[PASS]${C_RESET} No empty password accounts found in /etc/shadow"
        else
            echo -e "  ${C_RED}[FAIL]${C_RESET} Empty password accounts detected: ${empty_pass}"
        fi
    fi

    if [ -f "/etc/ssh/sshd_config" ]; then
        local root_login
        root_login=$(grep -E "^PermitRootLogin" /etc/ssh/sshd_config 2>/dev/null | awk '{print $2}')
        if [ "$root_login" = "no" ] || [ "$root_login" = "prohibit-password" ]; then
            echo -e "  ${C_GREEN}[PASS]${C_RESET} SSH PermitRootLogin = ${root_login}"
        else
            echo -e "  ${C_YELLOW}[WARN]${C_RESET} SSH PermitRootLogin is not disabled (currently: ${root_login:-default yes})"
        fi
    fi

    for s in telnetd rshd rlogind vsftpd; do
        if pgrep -x "$s" >/dev/null 2>&1; then
            echo -e "  ${C_RED}[FAIL]${C_RESET} Legacy insecure daemon running: ${s}"
        fi
    done
    echo -e "  ${C_GREEN}[PASS]${C_RESET} Legacy plaintext service audit complete."
    echo ""
}

cmd_traffic() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX NETWORK INTERFACE TRAFFIC TELEMETRY...${C_RESET}\n"
    if [ -r "/proc/net/dev" ]; then
        printf "  %-12s %-15s %-12s %-15s %-12s\n" "Interface" "RX Bytes" "RX Packets" "TX Bytes" "TX Packets"
        echo -e "  ----------------------------------------------------------------------"
        awk 'NR>2 {printf "  %-12s %-15s %-12s %-15s %-12s\n", $1, $2, $3, $10, $11}' /proc/net/dev
    elif command -v ip >/dev/null 2>&1; then
        ip -s link
    else
        netstat -i 2>/dev/null || echo "Network stats not available."
    fi
    echo ""
}

cmd_process_tree() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX PROCESS HIERARCHY & ANOMALY TREE...${C_RESET}\n"
    if command -v pstree >/dev/null 2>&1; then
        pstree -apcu | head -n 35
    elif command -v ps >/dev/null 2>&1; then
        ps -ejH 2>/dev/null | head -n 35 || ps -ef | head -n 35
    fi
    echo ""
}

cmd_tls_audit() {
    local host="$1"
    local port="${2:-443}"
    if [ -z "$host" ]; then
        echo -e "${C_RED}[!] Error: Target host required.${C_RESET}\nUsage: ax tls-audit <hostname> [port]"
        exit 1
    fi
    echo -e "${C_CYAN}${C_BOLD}[*] AUDITING TLS PROTOCOLS & EXPIRATION FOR: ${C_WHITE}${host}:${port}${C_RESET}\n"
    
    if command -v openssl >/dev/null 2>&1; then
        local cert_info
        cert_info=$(echo | openssl s_client -connect "${host}:${port}" -servername "$host" 2>/dev/null || true)
        local expiry
        expiry=$(echo "$cert_info" | openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2 || echo "Unknown")
        local subject
        subject=$(echo "$cert_info" | openssl x509 -noout -subject 2>/dev/null | cut -d= -f2- || echo "Unknown")
        local issuer
        issuer=$(echo "$cert_info" | openssl x509 -noout -issuer 2>/dev/null | cut -d= -f2- || echo "Unknown")
        
        echo -e "  ${C_CYAN}Subject:${C_RESET}    ${subject}"
        echo -e "  ${C_CYAN}Issuer:${C_RESET}     ${issuer}"
        echo -e "  ${C_CYAN}Expires On:${C_RESET} ${C_YELLOW}${expiry}${C_RESET}"
    else
        echo -e "${C_RED}[!] OpenSSL required for TLS audit.${C_RESET}"
    fi
    echo ""
}

cmd_env_audit() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX RUNTIME ENVIRONMENT & PATH HYGIENE AUDIT...${C_RESET}\n"

    if echo "$PATH" | grep -q "\(^\|:\)\.\($\|:\)"; then
        echo -e "  ${C_RED}[WARN] Dangerous entry '.' (current directory) detected in \$PATH!${C_RESET}"
    else
        echo -e "  ${C_GREEN}[PASS] \$PATH is free of relative directory entries.${C_RESET}"
    fi

    local sensitive_vars
    sensitive_vars=$(env | grep -iE '^(AWS_|GITHUB_|TOKEN|SECRET|PASSWORD|PASSWD|KEY)=' | cut -d= -f1 || true)
    if [ -n "$sensitive_vars" ]; then
        echo -e "  ${C_YELLOW}[!] Sensitive environment variable names present in session:${C_RESET}"
        for v in $sensitive_vars; do
            echo -e "      ${C_WHITE}- ${v}${C_RESET}"
        done
    else
        echo -e "  ${C_GREEN}[PASS] No common sensitive credential variables detected in environment.${C_RESET}"
    fi
    echo ""
}

cmd_ip_geo() {
    local target="${1:-}"
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX IP GEOLOCATION & ASN INTELLIGENCE RADAR...${C_RESET}\n"
    local query_url="http://ip-api.com/json/${target}?fields=status,message,country,countryCode,regionName,city,zip,lat,lon,timezone,isp,org,as,query"
    
    if command -v curl >/dev/null 2>&1; then
        local resp
        resp=$(curl -s -m 5 "$query_url" 2>/dev/null || true)
        if [[ "$resp" == *"\"status\":\"success\""* ]]; then
            local ip country region city isp asn tz lat lon
            ip=$(echo "$resp" | grep -o '"query":"[^"]*"' | cut -d'"' -f4)
            country=$(echo "$resp" | grep -o '"country":"[^"]*"' | cut -d'"' -f4)
            region=$(echo "$resp" | grep -o '"regionName":"[^"]*"' | cut -d'"' -f4)
            city=$(echo "$resp" | grep -o '"city":"[^"]*"' | cut -d'"' -f4)
            isp=$(echo "$resp" | grep -o '"isp":"[^"]*"' | cut -d'"' -f4)
            asn=$(echo "$resp" | grep -o '"as":"[^"]*"' | cut -d'"' -f4)
            tz=$(echo "$resp" | grep -o '"timezone":"[^"]*"' | cut -d'"' -f4)
            lat=$(echo "$resp" | grep -o '"lat":[^,]*' | cut -d: -f2)
            lon=$(echo "$resp" | grep -o '"lon":[^,]*' | cut -d: -f2)
            
            echo -e "  ${C_CYAN}Target IP:${C_RESET}     ${C_WHITE}${C_BOLD}${ip}${C_RESET}"
            echo -e "  ${C_CYAN}Location:${C_RESET}      ${C_GREEN}${city}, ${region}, ${country}${C_RESET}"
            echo -e "  ${C_CYAN}Coordinates:${C_RESET}   Lat ${lat}, Lon ${lon}"
            echo -e "  ${C_CYAN}Timezone:${C_RESET}      ${tz}"
            echo -e "  ${C_CYAN}ISP Provider:${C_RESET}  ${isp}"
            echo -e "  ${C_CYAN}Autonomous Sys:${C_RESET}${asn}"
        else
            echo -e "${C_YELLOW}[!] Geolocation lookup failed or API limit reached.${C_RESET}"
        fi
    else
        echo -e "${C_RED}[!] curl is required for IP geolocation lookup.${C_RESET}"
    fi
    echo ""
}

cmd_cert_create() {
    local domain="${1:-localhost}"
    local days="${2:-365}"
    local key_file="${domain}.key"
    local crt_file="${domain}.crt"
    
    echo -e "${C_CYAN}${C_BOLD}[*] GENERATING SELF-SIGNED X.509 TLS CERTIFICATE: ${C_WHITE}${domain}${C_RESET}"
    echo -e "${C_GRAY}Validity: ${days} days | Output: ${key_file}, ${crt_file}${C_RESET}\n"
    
    if command -v openssl >/dev/null 2>&1; then
        openssl req -x509 -nodes -newkey rsa:4096 -keyout "$key_file" -out "$crt_file" -days "$days" \
            -subj "/C=US/ST=Cyber/L=Metropolis/O=ASTERIX OS/CN=${domain}" 2>/dev/null
        echo -e "  ${C_GREEN}[✔] Private Key generated: ${key_file}${C_RESET}"
        echo -e "  ${C_GREEN}[✔] Public Cert generated: ${crt_file}${C_RESET}"
        local sha256
        sha256=$(openssl x509 -noout -fingerprint -sha256 -in "$crt_file" 2>/dev/null | cut -d= -f2)
        echo -e "  ${C_CYAN}SHA-256 Fingerprint:${C_RESET} ${sha256}"
    else
        echo -e "${C_RED}[!] openssl required to generate certificates.${C_RESET}"
    fi
    echo ""
}

cmd_cron_audit() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX SCHEDULED TASKS & PERSISTENCE TIMERS AUDIT...${C_RESET}\n"
    
    echo -e "${C_WHITE}${C_BOLD}[1] User Crontab Entries:${C_RESET}"
    local user_cron
    user_cron=$(crontab -l 2>/dev/null | grep -v '^#' | grep -v '^$' || true)
    if [ -n "$user_cron" ]; then
        echo "$user_cron"
    else
        echo -e "  ${C_GRAY}No user crontab tasks configured.${C_RESET}"
    fi
    
    echo -e "\n${C_WHITE}${C_BOLD}[2] System-Wide Cron Schedules (/etc/cron.*):${C_RESET}"
    if [ -r "/etc/crontab" ]; then
        grep -v '^#' /etc/crontab | grep -v '^$' || true
    fi
    ls -la /etc/cron.d /etc/cron.daily 2>/dev/null | head -n 12 || true

    echo -e "\n${C_WHITE}${C_BOLD}[3] Active Systemd Timers:${C_RESET}"
    if command -v systemctl >/dev/null 2>&1; then
        systemctl list-timers --no-pager --no-legend 2>/dev/null | head -n 6 || true
    else
        echo -e "  ${C_GRAY}systemctl not available on this target.${C_RESET}"
    fi
    echo ""
}

cmd_disk_io() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX REAL-TIME STORAGE BLOCK DEVICE I/O METRICS...${C_RESET}\n"
    if [ -r "/proc/diskstats" ]; then
        printf "  %-12s %-12s %-14s %-12s %-14s %-10s\n" "Device" "Reads Comp" "Sectors Read" "Writes Comp" "Sectors Written" "IO Active"
        echo -e "  --------------------------------------------------------------------------------"
        awk '$3 ~ /^(sd[a-z]|nvme[0-9]n[0-9]|mmcblk[0-9]|vd[a-z])/ {printf "  %-12s %-12s %-14s %-12s %-14s %-10s\n", $3, $4, $6, $8, $10, $12}' /proc/diskstats
    elif command -v iostat >/dev/null 2>&1; then
        iostat -d 1 1
    else
        echo -e "${C_YELLOW}[!] /proc/diskstats not accessible.${C_RESET}"
    fi
    echo ""
}

cmd_net_route() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX KERNEL ROUTING TABLE & GATEWAY TOPOLOGY...${C_RESET}\n"
    if command -v ip >/dev/null 2>&1; then
        ip route show
    elif command -v route >/dev/null 2>&1; then
        route -n
    elif [ -r "/proc/net/route" ]; then
        cat /proc/net/route
    else
        netstat -rn 2>/dev/null || echo -e "${C_RED}[!] No routing tools available.${C_RESET}"
    fi
    echo ""
}

cmd_uptime_stats() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX LOAD AVERAGES, SCHEDULER & SESSION TELEMETRY...${C_RESET}\n"
    if [ -r "/proc/loadavg" ]; then
        local l1 l5 l15 procs last_pid
        read -r l1 l5 l15 procs last_pid < /proc/loadavg
        echo -e "  ${C_CYAN}Load Average (1m, 5m, 15m):${C_RESET} ${C_GREEN}${l1}${C_RESET}, ${C_YELLOW}${l5}${C_RESET}, ${C_MAGENTA}${l15}${C_RESET}"
        echo -e "  ${C_CYAN}Active Threads / Entities:${C_RESET}   ${procs}"
        echo -e "  ${C_CYAN}Latest Allocated PID:${C_RESET}        ${last_pid}"
    fi
    
    echo -e "  ${C_CYAN}Uptime Summary:${C_RESET}              $(uptime 2>/dev/null || true)"
    echo -e "\n${C_WHITE}${C_BOLD}Active Interactive User Sessions:${C_RESET}"
    who 2>/dev/null || w 2>/dev/null || echo "  No interactive sessions."
    echo ""
}

cmd_json_format() {
    local target="$1"
    if [ -z "$target" ]; then
        echo -e "${C_RED}[!] Error: JSON string or file required.${C_RESET}\nUsage: ax json-format <file.json|'{\"key\":\"val\"}'>"
        exit 1
    fi
    
    if [ -f "$target" ]; then
        if command -v jq >/dev/null 2>&1; then
            jq . "$target"
        elif command -v python3 >/dev/null 2>&1; then
            python3 -m json.tool "$target"
        else
            cat "$target"
        fi
    else
        if command -v jq >/dev/null 2>&1; then
            echo "$target" | jq .
        elif command -v python3 >/dev/null 2>&1; then
            echo "$target" | python3 -m json.tool
        else
            echo "$target"
        fi
    fi
}

cmd_listening() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX DEEP LISTENING SOCKET & SERVICE AUDIT...${C_RESET}\n"
    if command -v ss >/dev/null 2>&1; then
        ss -tulnp 2>/dev/null || ss -tuln
    elif command -v netstat >/dev/null 2>&1; then
        netstat -tulnp 2>/dev/null || netstat -tuln
    elif command -v lsof >/dev/null 2>&1; then
        run_as_root lsof -i -P -n | grep LISTEN
    else
        echo -e "${C_YELLOW}[!] No socket inspection utilities (ss/netstat/lsof) detected.${C_RESET}"
    fi
    echo ""
}

cmd_battery() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX POWER SUPPLY & BATTERY TELEMETRY...${C_RESET}\n"
    local found=0
    for b in /sys/class/power_supply/BAT*; do
        if [ -d "$b" ]; then
            found=1
            local cap status tech
            cap=$(cat "$b/capacity" 2>/dev/null || echo "N/A")
            status=$(cat "$b/status" 2>/dev/null || echo "N/A")
            tech=$(cat "$b/technology" 2>/dev/null || echo "N/A")
            echo -e "  ${C_CYAN}Device:${C_RESET}     $(basename "$b")"
            echo -e "  ${C_CYAN}Capacity:${C_RESET}   ${C_GREEN}${cap}%${C_RESET}"
            echo -e "  ${C_CYAN}Status:${C_RESET}     ${C_YELLOW}${status}${C_RESET}"
            echo -e "  ${C_CYAN}Technology:${C_RESET} ${tech}"
        fi
    done
    
    if [ "$found" -eq 0 ]; then
        if command -v termux-battery-status >/dev/null 2>&1; then
            termux-battery-status
        elif command -v upower >/dev/null 2>&1; then
            upower -i "$(upower -e | grep battery | head -n 1)" 2>/dev/null || true
        else
            echo -e "  ${C_GRAY}No physical battery or power supply detected (AC power or Virtual Machine).${C_RESET}"
        fi
    fi
    echo ""
}

cmd_pkg_verify() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX SYSTEM PACKAGE INTEGRITY VERIFICATION...${C_RESET}\n"
    if command -v debsums >/dev/null 2>&1; then
        echo -e "${C_YELLOW}[*] Auditing installed Debian packages for file alterations via debsums...${C_RESET}"
        run_as_root debsums -c 2>/dev/null || echo -e "${C_GREEN}[✔] All package checksums verified.${C_RESET}"
    elif command -v pacman >/dev/null 2>&1; then
        echo -e "${C_YELLOW}[*] Auditing Pacman packages for file alterations...${C_RESET}"
        pacman -Qk 2>/dev/null | grep -v '0 missing files' || echo -e "${C_GREEN}[✔] All packages intact.${C_RESET}"
    elif command -v rpm >/dev/null 2>&1; then
        echo -e "${C_YELLOW}[*] Auditing RPM packages for file alterations...${C_RESET}"
        rpm -Va 2>/dev/null | head -n 25 || echo -e "${C_GREEN}[✔] All packages intact.${C_RESET}"
    else
        echo -e "${C_YELLOW}[!] Package integrity tool (debsums/pacman -Qk/rpm -Va) not installed.${C_RESET}"
        echo -e "${C_GRAY}[i] Install debsums: ax install debsums${C_RESET}"
    fi
    echo ""
}

# ---------------------------------------------------------------------
# 11. Advanced Offensive & Forensics Modules (v2.8.0)
# ---------------------------------------------------------------------

cmd_ssh_audit() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX SSH CONFIGURATION AUDITOR...${C_RESET}\n"
    local cfg="/etc/ssh/sshd_config"
    if [ ! -f "$cfg" ]; then echo -e "${C_YELLOW}[!] sshd_config not found. SSH server not installed.${C_RESET}"; return 1; fi
    echo -e "${C_WHITE}${C_BOLD}--- SSHD CONFIG REVIEW ---${C_RESET}"
    echo -e "${C_YELLOW}[*] PermitRootLogin:${C_RESET}      $(grep -i PermitRootLogin "$cfg" 2>/dev/null | tail -1 || echo 'not set (default: prohibit-password)')"
    echo -e "${C_YELLOW}[*] PasswordAuthentication:${C_RESET}$(grep -i PasswordAuthentication "$cfg" 2>/dev/null | tail -1 || echo 'not set (default: yes)')"
    echo -e "${C_YELLOW}[*] PubkeyAuthentication:${C_RESET} $(grep -i PubkeyAuthentication "$cfg" 2>/dev/null | tail -1 || echo 'not set (default: yes)')"
    echo -e "${C_YELLOW}[*] Port:${C_RESET}                 $(grep -i '^Port ' "$cfg" 2>/dev/null | tail -1 || echo 'not set (default: 22)')"
    echo -e "${C_YELLOW}[*] AllowUsers:${C_RESET}           $(grep -i AllowUsers "$cfg" 2>/dev/null | tail -1 || echo 'not set (all users allowed)')"
    echo -e "${C_YELLOW}[*] MaxAuthTries:${C_RESET}         $(grep -i MaxAuthTries "$cfg" 2>/dev/null | tail -1 || echo 'not set (default: 6)')"
    echo -e "${C_YELLOW}[*] X11Forwarding:${C_RESET}        $(grep -i X11Forwarding "$cfg" 2>/dev/null | tail -1 || echo 'not set')"
    echo -e "${C_YELLOW}[*] Protocol:${C_RESET}             $(grep -i Protocol "$cfg" 2>/dev/null | tail -1 || echo 'SSH-2 only (default)')"
    echo ""
    echo -e "${C_WHITE}${C_BOLD}--- ACTIVE SSH SESSIONS ---${C_RESET}"
    if command -v ss >/dev/null 2>&1; then
        ss -tnp | grep ':22 ' 2>/dev/null || echo -e "${C_GREEN}[✔] No active SSH sessions on port 22.${C_RESET}"
    fi
    echo ""
    echo -e "${C_WHITE}${C_BOLD}--- AUTHORIZED KEYS (ALL USERS) ---${C_RESET}"
    for home in /root /home/*; do
        local ak="$home/.ssh/authorized_keys"
        if [ -f "$ak" ]; then
            local count; count=$(wc -l < "$ak" 2>/dev/null); echo -e "  ${C_YELLOW}$ak${C_RESET} — ${C_BOLD}$count key(s)${C_RESET}"
        fi
    done
    echo ""
}

cmd_arp_detect() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX ARP SPOOFING DETECTOR...${C_RESET}\n"
    echo -e "${C_WHITE}${C_BOLD}--- LOCAL ARP CACHE ---${C_RESET}"
    if command -v arp >/dev/null 2>&1; then
        arp -n 2>/dev/null | head -n 40
    elif [ -f /proc/net/arp ]; then
        cat /proc/net/arp
    else
        echo -e "${C_YELLOW}[!] arp command not available.${C_RESET}"
    fi
    echo ""
    echo -e "${C_WHITE}${C_BOLD}--- DUPLICATE MAC DETECTION ---${C_RESET}"
    if [ -f /proc/net/arp ]; then
        awk 'NR>1 {print $4}' /proc/net/arp | sort | uniq -d | while read -r mac; do
            echo -e "${C_RED}[!!] DUPLICATE MAC DETECTED: $mac — Possible ARP poisoning!${C_RESET}"
        done
        awk 'NR>1 {print $4}' /proc/net/arp | sort | uniq -D | grep -qv 'DUPLICATE' || echo -e "${C_GREEN}[✔] No duplicate MACs found in ARP cache.${C_RESET}"
    fi
    echo ""
}

cmd_hexdump() {
    local file="$1"
    if [ -z "$file" ]; then echo -e "${C_RED}[!] Usage: ax hexdump <file>${C_RESET}"; return 1; fi
    if [ ! -f "$file" ]; then echo -e "${C_RED}[!] File not found: $file${C_RESET}"; return 1; fi
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX HEXDUMP VIEWER: $file${C_RESET}\n"
    if command -v xxd >/dev/null 2>&1; then
        xxd "$file" | head -n 80
    elif command -v od >/dev/null 2>&1; then
        od -A x -t x1z -v "$file" | head -n 80
    else
        echo -e "${C_YELLOW}[!] Neither xxd nor od found. Install with: ax install xxd${C_RESET}"
    fi
    echo ""
}

cmd_strings_scan() {
    local target="${1:-.}"
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX STRINGS FORENSIC SCANNER: $target${C_RESET}\n"
    if ! command -v strings >/dev/null 2>&1; then
        echo -e "${C_YELLOW}[!] strings not installed. ax install binutils${C_RESET}"; return 1
    fi
    if [ -f "$target" ]; then
        echo -e "${C_WHITE}${C_BOLD}--- INTERESTING STRINGS IN $target ---${C_RESET}"
        strings "$target" | grep -Ei 'http|ftp|password|passwd|secret|token|key|api|sql|exec|eval|base64' | head -n 50
    else
        echo -e "${C_WHITE}${C_BOLD}--- SCANNING DIRECTORY: $target ---${C_RESET}"
        find "$target" -type f \( -name "*.sh" -o -name "*.py" -o -name "*.php" -o -name "*.js" \) 2>/dev/null | while read -r f; do
            strings "$f" 2>/dev/null | grep -Ei 'password|secret|token|api.key' | head -n 5 | while read -r s; do
                echo -e "  ${C_YELLOW}$f${C_RESET}: ${C_RED}$s${C_RESET}"
            done
        done
    fi
    echo ""
}

cmd_shadow_audit() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX SHADOW/PASSWD FILE SECURITY AUDIT...${C_RESET}\n"
    echo -e "${C_WHITE}${C_BOLD}--- ACCOUNTS WITH EMPTY PASSWORDS ---${C_RESET}"
    run_as_root awk -F: '($2 == "" || $2 == "!") {print "  [!] " $1 ": NO/LOCKED PASSWORD"}' /etc/shadow 2>/dev/null || echo "  (need root)"
    echo ""
    echo -e "${C_WHITE}${C_BOLD}--- UID 0 ACCOUNTS (POTENTIAL BACKDOORS) ---${C_RESET}"
    awk -F: '($3 == 0) {print "  [!!] UID-0: " $1}' /etc/passwd 2>/dev/null
    echo ""
    echo -e "${C_WHITE}${C_BOLD}--- USERS WITH SHELL ACCESS ---${C_RESET}"
    awk -F: '($7 !~ /(nologin|false|sync|halt|shutdown)/) {print "  " $1 " -> " $7}' /etc/passwd 2>/dev/null
    echo ""
    echo -e "${C_WHITE}${C_BOLD}--- PASSWD FILE PERMISSIONS ---${C_RESET}"
    ls -la /etc/passwd /etc/shadow 2>/dev/null
    echo ""
}

cmd_usb_audit() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX USB DEVICE SECURITY AUDIT...${C_RESET}\n"
    echo -e "${C_WHITE}${C_BOLD}--- CURRENTLY CONNECTED USB DEVICES ---${C_RESET}"
    if command -v lsusb >/dev/null 2>&1; then
        lsusb 2>/dev/null
    else
        echo -e "${C_YELLOW}[!] lsusb not found. ax install usbutils${C_RESET}"
    fi
    echo ""
    echo -e "${C_WHITE}${C_BOLD}--- USB STORAGE MOUNTS ---${C_RESET}"
    lsblk -o NAME,TYPE,SIZE,MOUNTPOINT,LABEL 2>/dev/null | grep -i 'disk\|part\|usb' || cat /proc/mounts 2>/dev/null | grep -i 'usb\|sd[b-z]'
    echo ""
    echo -e "${C_WHITE}${C_BOLD}--- USB DEVICE KERNEL LOG (LAST 25 EVENTS) ---${C_RESET}"
    dmesg 2>/dev/null | grep -i 'usb\|mass storage' | tail -n 25 || echo -e "${C_GRAY}[i] No USB events in dmesg (may need root).${C_RESET}"
    echo ""
}

cmd_dmesg_watch() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX KERNEL RING BUFFER MONITOR...${C_RESET}\n"
    echo -e "${C_WHITE}${C_BOLD}--- RECENT KERNEL SECURITY EVENTS ---${C_RESET}"
    dmesg 2>/dev/null | grep -Ei 'error|fail|warn|oom|killed|segfault|null pointer|panic|attack|denied|blocked|firewall|iptable|nftable|audit' | tail -n 40 || echo -e "${C_GREEN}[✔] No critical kernel events found.${C_RESET}"
    echo ""
    echo -e "${C_WHITE}${C_BOLD}--- HARDWARE ERRORS ---${C_RESET}"
    dmesg 2>/dev/null | grep -i 'hardware error\|mce\|ecc\|edac' | tail -n 10 || echo -e "${C_GREEN}[✔] No hardware errors detected.${C_RESET}"
    echo ""
}

cmd_net_neighbors() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX NETWORK NEIGHBORS & ARP TABLE...${C_RESET}\n"
    echo -e "${C_WHITE}${C_BOLD}--- IP NEIGHBOR TABLE (ARP/NDP) ---${C_RESET}"
    if command -v ip >/dev/null 2>&1; then
        ip neigh show 2>/dev/null | while read -r line; do
            if echo "$line" | grep -q 'REACHABLE'; then
                echo -e "  ${C_GREEN}$line${C_RESET}"
            elif echo "$line" | grep -q 'STALE\|FAILED'; then
                echo -e "  ${C_YELLOW}$line${C_RESET}"
            else
                echo -e "  $line"
            fi
        done
    else
        arp -a 2>/dev/null || cat /proc/net/arp
    fi
    echo ""
}

cmd_nft_rules() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX NFTABLES/IPTABLES FIREWALL RULESET...${C_RESET}\n"
    if command -v nft >/dev/null 2>&1; then
        echo -e "${C_WHITE}${C_BOLD}--- NFTABLES RULESET ---${C_RESET}"
        run_as_root nft list ruleset 2>/dev/null || echo -e "${C_YELLOW}[!] Need root or nftables not configured.${C_RESET}"
    fi
    echo ""
    echo -e "${C_WHITE}${C_BOLD}--- IPTABLES RULES (filter) ---${C_RESET}"
    if command -v iptables >/dev/null 2>&1; then
        run_as_root iptables -L -n -v 2>/dev/null | head -n 50 || echo -e "${C_YELLOW}[!] Need root for iptables.${C_RESET}"
    fi
    echo ""
    echo -e "${C_WHITE}${C_BOLD}--- UFW STATUS ---${C_RESET}"
    if command -v ufw >/dev/null 2>&1; then
        run_as_root ufw status verbose 2>/dev/null || echo -e "${C_YELLOW}[!] Need root for ufw.${C_RESET}"
    else
        echo -e "${C_GRAY}[i] UFW not installed.${C_RESET}"
    fi
    echo ""
}

cmd_syscall_trace() {
    local pid="$1"
    if [ -z "$pid" ]; then echo -e "${C_RED}[!] Usage: ax syscall-trace <PID>${C_RESET}"; return 1; fi
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX SYSCALL TRACER — PID: $pid${C_RESET}\n"
    if command -v strace >/dev/null 2>&1; then
        echo -e "${C_YELLOW}[*] Attaching strace to PID $pid (Ctrl+C to stop)...${C_RESET}\n"
        run_as_root strace -p "$pid" -e trace=network,file,process,signal -T 2>&1 | head -n 60
    elif [ -d "/proc/$pid" ]; then
        echo -e "${C_YELLOW}[!] strace not installed. Showing /proc/$pid info instead.${C_RESET}\n"
        echo -e "${C_WHITE}Status:${C_RESET}"; cat "/proc/$pid/status" 2>/dev/null | head -n 20
        echo -e "${C_WHITE}Open FDs:${C_RESET}"; ls -la "/proc/$pid/fd" 2>/dev/null | head -n 20
        echo -e "${C_WHITE}Maps:${C_RESET}"; head -n 15 "/proc/$pid/maps" 2>/dev/null
    else
        echo -e "${C_RED}[!] PID $pid not found.${C_RESET}"
    fi
    echo ""
}

cmd_open_files() {
    local target="${1:-}"
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX OPEN FILE DESCRIPTOR AUDIT...${C_RESET}\n"
    if command -v lsof >/dev/null 2>&1; then
        if [ -n "$target" ]; then
            echo -e "${C_WHITE}${C_BOLD}--- OPEN FILES FOR: $target ---${C_RESET}"
            lsof -u "$target" 2>/dev/null | head -n 40
        else
            echo -e "${C_WHITE}${C_BOLD}--- TOP PROCESSES BY OPEN FILE DESCRIPTORS ---${C_RESET}"
            lsof 2>/dev/null | awk '{print $1}' | sort | uniq -c | sort -rn | head -n 20
            echo ""
            echo -e "${C_WHITE}${C_BOLD}--- OPEN NETWORK SOCKETS ---${C_RESET}"
            lsof -i 2>/dev/null | grep -E 'ESTABLISHED|LISTEN' | head -n 30
        fi
    else
        echo -e "${C_WHITE}${C_BOLD}--- OPEN FILE DESCRIPTORS (/proc) ---${C_RESET}"
        for pid in /proc/[0-9]*/fd; do
            local count; count=$(ls "$pid" 2>/dev/null | wc -l)
            if [ "$count" -gt 50 ] 2>/dev/null; then
                local name; name=$(cat "$(dirname $pid)/comm" 2>/dev/null)
                echo -e "  PID $(basename $(dirname $pid)) ($name): ${C_YELLOW}$count FDs${C_RESET}"
            fi
        done
    fi
    echo ""
}

cmd_container_escape() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX CONTAINER ESCAPE RISK ASSESSMENT...${C_RESET}\n"
    echo -e "${C_WHITE}${C_BOLD}--- ENVIRONMENT DETECTION ---${C_RESET}"
    local in_container=0
    if [ -f /.dockerenv ]; then echo -e "  ${C_RED}[!!] Running INSIDE a Docker container (.dockerenv found)${C_RESET}"; in_container=1; fi
    if [ -f /run/.containerenv ]; then echo -e "  ${C_RED}[!!] Running INSIDE a Podman/OCI container (.containerenv found)${C_RESET}"; in_container=1; fi
    if grep -q 'docker\|lxc\|containerd\|kubepods' /proc/1/cgroup 2>/dev/null; then
        echo -e "  ${C_RED}[!!] cgroup fingerprint indicates container environment${C_RESET}"; in_container=1
    fi
    [ "$in_container" -eq 0 ] && echo -e "  ${C_GREEN}[✔] Not running inside a container.${C_RESET}"
    echo ""
    echo -e "${C_WHITE}${C_BOLD}--- PRIVILEGED/CAPABILITY CHECKS ---${C_RESET}"
    if command -v capsh >/dev/null 2>&1; then capsh --print 2>/dev/null | head -n 10; fi
    grep -i cap_sys_admin /proc/self/status 2>/dev/null || true
    echo ""
    echo -e "${C_WHITE}${C_BOLD}--- HOST FILESYSTEM MOUNT LEAKS ---${C_RESET}"
    cat /proc/mounts 2>/dev/null | grep -v 'overlay\|tmpfs\|proc\|sysfs\|devpts\|cgroup' | head -n 15
    echo ""
    echo -e "${C_WHITE}${C_BOLD}--- WRITABLE HOST PATHS ---${C_RESET}"
    for mp in /host /proc/sysrq-trigger /var/run/docker.sock /run/docker.sock; do
        [ -e "$mp" ] && echo -e "  ${C_RED}[!!] Dangerous path accessible: $mp${C_RESET}" || true
    done
    echo ""
}

cmd_port_knock() {
    local host="${1:-localhost}"
    local ports="${2:-7000,8000,9000}"
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX PORT KNOCK SEQUENCE: $host [$ports]${C_RESET}\n"
    IFS=',' read -ra plist <<< "$ports"
    for p in "${plist[@]}"; do
        echo -e "  ${C_YELLOW}[>] Knocking $host:$p ...${C_RESET}"
        if command -v nc >/dev/null 2>&1; then
            nc -z -w 1 "$host" "$p" 2>/dev/null || true
        else
            timeout 1 bash -c "echo >/dev/tcp/$host/$p" 2>/dev/null || true
        fi
        sleep 0.5
    done
    echo -e "\n${C_GREEN}[✔] Port knock sequence complete.${C_RESET}\n"
}

cmd_mem_regions() {
    local pid="${1:-self}"
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX PROCESS MEMORY MAP — PID: $pid${C_RESET}\n"
    local mapfile="/proc/$pid/maps"
    if [ ! -f "$mapfile" ]; then echo -e "${C_RED}[!] PID $pid not found or no access.${C_RESET}"; return 1; fi
    echo -e "${C_WHITE}${C_BOLD}--- MEMORY REGIONS ---${C_RESET}"
    awk '{
        split($1, a, "-");
        start=strtonum("0x"a[1]); end=strtonum("0x"a[2]);
        size=(end-start)/1024;
        printf "  %-20s %s  %7.1f KB  %s\n", $1, $2, size, $6
    }' "$mapfile" 2>/dev/null | head -n 40
    echo ""
    echo -e "${C_WHITE}${C_BOLD}--- MEMORY STATS ---${C_RESET}"
    cat "/proc/$pid/status" 2>/dev/null | grep -E 'VmSize|VmRSS|VmSwap|VmPeak|VmData|VmStk' | while read -r line; do
        echo -e "  $line"
    done
    echo ""
}

# ---------------------------------------------------------------------
# 12. Deep Core Root & Kernel Hardening Modules (v2.9.0)
# ---------------------------------------------------------------------

cmd_kmod_audit() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX DEEP KERNEL MODULE (LKM) & TAINT AUDITOR...${C_RESET}\n"
    echo -e "${C_WHITE}${C_BOLD}--- KERNEL TAINT STATUS ---${C_RESET}"
    if [ -f /proc/sys/kernel/tainted ]; then
        local taint; taint=$(cat /proc/sys/kernel/tainted 2>/dev/null)
        if [ "$taint" -eq 0 ] 2>/dev/null; then
            echo -e "  ${C_GREEN}[✔] Kernel is clean (Taint value: 0 - Pristine state)${C_RESET}"
        else
            echo -e "  ${C_RED}[!!] Kernel is TAINTED (Bitmask: $taint)${C_RESET}"
            [ $((taint & 1)) -ne 0 ] && echo -e "    ${C_YELLOW}-> Proprietary module loaded (P)${C_RESET}"
            [ $((taint & 2)) -ne 0 ] && echo -e "    ${C_YELLOW}-> Module was force loaded (F)${C_RESET}"
            [ $((taint & 4)) -ne 0 ] && echo -e "    ${C_YELLOW}-> Unsafe SMP/CPU architecture (S)${C_RESET}"
            [ $((taint & 8)) -ne 0 ] && echo -e "    ${C_YELLOW}-> Module force unloaded (R)${C_RESET}"
            [ $((taint & 32)) -ne 0 ] && echo -e "    ${C_YELLOW}-> Bad page reference / memory corruption (B)${C_RESET}"
            [ $((taint & 64)) -ne 0 ] && echo -e "    ${C_YELLOW}-> User requested taint (U)${C_RESET}"
            [ $((taint & 128)) -ne 0 ] && echo -e "    ${C_YELLOW}-> Kernel died previously / OOPS occurred (D)${C_RESET}"
            [ $((taint & 4096)) -ne 0 ] && echo -e "    ${C_YELLOW}-> Out-of-tree module loaded (O)${C_RESET}"
            [ $((taint & 8192)) -ne 0 ] && echo -e "    ${C_YELLOW}-> Unsigned module loaded (E)${C_RESET}"
        fi
    fi
    echo ""
    echo -e "${C_WHITE}${C_BOLD}--- MODULE LOADING RESTRICTIONS ---${C_RESET}"
    if [ -f /proc/sys/kernel/modules_disabled ]; then
        local mod_dis; mod_dis=$(cat /proc/sys/kernel/modules_disabled 2>/dev/null)
        if [ "$mod_dis" -eq 1 ]; then
            echo -e "  ${C_GREEN}[✔] kernel.modules_disabled = 1 (LKM loading permanently locked)${C_RESET}"
        else
            echo -e "  ${C_YELLOW}[!] kernel.modules_disabled = 0 (Runtime module insertion allowed)${C_RESET}"
        fi
    fi
    echo ""
    echo -e "${C_WHITE}${C_BOLD}--- SUSPICIOUS / UNLINKED LOADED MODULES ---${C_RESET}"
    if [ -f /proc/modules ]; then
        local kver; kver=$(uname -r 2>/dev/null)
        local mod_dep="/lib/modules/$kver/modules.dep"
        local anomalous=0
        awk '{print $1}' /proc/modules | head -n 35 | while read -r mod; do
            if [ -f "$mod_dep" ] && ! grep -q "/$mod\.ko" "$mod_dep" 2>/dev/null; then
                echo -e "  ${C_RED}[!!] Out-of-tree / Unindexed module: $mod${C_RESET}"
                anomalous=1
            fi
        done
        [ "$anomalous" -eq 0 ] && echo -e "  ${C_GREEN}[✔] Sampled LKMs correspond to official module tree.${C_RESET}"
        echo -e "\n  ${C_CYAN}Total active modules in kernel:${C_RESET} $(wc -l < /proc/modules 2>/dev/null)"
    fi
    echo ""
}

cmd_deleted_procs() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX GHOST PROCESS & DELETED BINARY AUDITOR...${C_RESET}\n"
    echo -e "${C_WHITE}${C_BOLD}--- PROCESSES RUNNING FROM DELETED / UNLINKED BINARIES ---${C_RESET}"
    local count=0
    for exe in /proc/[0-9]*/exe; do
        if [ -L "$exe" ]; then
            local target; target=$(readlink "$exe" 2>/dev/null || true)
            if echo "$target" | grep -q '(deleted)'; then
                local pid; pid=$(basename "$(dirname "$exe")")
                local comm; comm=$(cat "/proc/$pid/comm" 2>/dev/null || echo "unknown")
                local user; user=$(ps -o user= -p "$pid" 2>/dev/null || echo "?")
                echo -e "  ${C_RED}[!!] GHOST BINARY DETECTED:${C_RESET} PID ${C_YELLOW}$pid${C_RESET} ($comm) by user ${C_YELLOW}$user${C_RESET}"
                echo -e "       Original path: $target"
                count=$((count + 1))
            fi
        fi
    done
    if [ "$count" -eq 0 ]; then
        echo -e "  ${C_GREEN}[✔] No ghost processes running from unlinked binaries detected.${C_RESET}"
    else
        echo -e "\n  ${C_RED}[!] Total stealth deleted processes found: $count${C_RESET}"
    fi
    echo ""
}

cmd_cap_audit() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX LINUX FILE & AMBIENT CAPABILITIES AUDIT...${C_RESET}\n"
    echo -e "${C_WHITE}${C_BOLD}--- HIGH-RISK BINARY FILE CAPABILITIES ---${C_RESET}"
    if command -v getcap >/dev/null 2>&1; then
        local found=0
        run_as_root getcap -r /bin /sbin /usr/bin /usr/sbin 2>/dev/null | while read -r line; do
            if echo "$line" | grep -qE 'cap_setuid|cap_sys_admin|cap_dac_override|cap_net_raw|cap_sys_ptrace'; then
                echo -e "  ${C_RED}[!!] CRITICAL CAP:${C_RESET} $line"
            else
                echo -e "  ${C_YELLOW}[*] Cap:${C_RESET} $line"
            fi
            found=1
        done
        [ "$found" -eq 0 ] && echo -e "  ${C_GREEN}[✔] No abnormal file capabilities discovered.${C_RESET}"
    else
        echo -e "${C_YELLOW}[!] getcap utility not available. ax install libcap2-bin${C_RESET}"
    fi
    echo ""
    echo -e "${C_WHITE}${C_BOLD}--- CURRENT SHELL BOUNDING CAPABILITIES ---${C_RESET}"
    if [ -f /proc/self/status ]; then
        grep -E 'CapInh|CapPrm|CapEff|CapBnd|CapAmb' /proc/self/status 2>/dev/null | while read -r cap; do
            echo -e "  $cap"
        done
    fi
    echo ""
}

cmd_ebpf_audit() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX eBPF ENGINE & HOOK AUDITOR...${C_RESET}\n"
    echo -e "${C_WHITE}${C_BOLD}--- UNPRIVILEGED BPF POLICY ---${C_RESET}"
    if [ -f /proc/sys/kernel/unprivileged_bpf_disabled ]; then
        local bpf_dis; bpf_dis=$(cat /proc/sys/kernel/unprivileged_bpf_disabled 2>/dev/null)
        if [ "$bpf_dis" -ge 1 ] 2>/dev/null; then
            echo -e "  ${C_GREEN}[✔] unprivileged_bpf_disabled = $bpf_dis (Restricted to privileged admin)${C_RESET}"
        else
            echo -e "  ${C_RED}[!] unprivileged_bpf_disabled = 0 (Unprivileged users can load eBPF bytecode!)${C_RESET}"
        fi
    fi
    echo ""
    echo -e "${C_WHITE}${C_BOLD}--- LOADED eBPF PROGRAMS ---${C_RESET}"
    if command -v bpftool >/dev/null 2>&1; then
        run_as_root bpftool prog list 2>/dev/null | head -n 30 || echo "  No eBPF programs reported or need root."
    elif [ -d /sys/fs/bpf ]; then
        local pinned; pinned=$(ls -A /sys/fs/bpf 2>/dev/null | wc -l)
        echo -e "  Pinned BPF objects in /sys/fs/bpf: ${C_YELLOW}$pinned${C_RESET}"
    else
        echo -e "${C_GRAY}[i] bpftool not installed. ax install linux-tools-generic / bpf-tools${C_RESET}"
    fi
    echo ""
}

cmd_root_persistence() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX DEEP ROOT PERSISTENCE VECTOR SCANNER...${C_RESET}\n"
    echo -e "${C_WHITE}${C_BOLD}--- 1. SHARED LIBRARY HOOKS (ld.so.preload) ---${C_RESET}"
    if [ -f /etc/ld.so.preload ]; then
        echo -e "  ${C_RED}[!!] WARNING: /etc/ld.so.preload exists!${C_RESET}"
        cat /etc/ld.so.preload 2>/dev/null
    else
        echo -e "  ${C_GREEN}[✔] No /etc/ld.so.preload detected (clean).${C_RESET}"
    fi
    echo ""
    echo -e "${C_WHITE}${C_BOLD}--- 2. SYSTEMD SYSTEM GENERATORS ---${C_RESET}"
    for gen in /lib/systemd/system-generators /etc/systemd/system-generators /usr/lib/systemd/system-generators; do
        if [ -d "$gen" ] && [ "$(ls -A "$gen" 2>/dev/null)" ]; then
            echo -e "  ${C_YELLOW}[*] Generator in $gen:${C_RESET}"
            ls -la "$gen" 2>/dev/null
        fi
    done
    echo ""
    echo -e "${C_WHITE}${C_BOLD}--- 3. CRON SPOOL & RECURRING HOOKS ---${C_RESET}"
    ls -la /etc/cron.d /etc/cron.daily /etc/cron.hourly 2>/dev/null | head -n 25
    echo ""
    echo -e "${C_WHITE}${C_BOLD}--- 4. PAM AUTHENTICATION HOOKS ---${C_RESET}"
    grep -rn "pam_exec" /etc/pam.d/ 2>/dev/null || echo -e "  ${C_GREEN}[✔] No pam_exec backdoor triggers discovered.${C_RESET}"
    echo ""
}

cmd_seccomp_audit() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX SECCOMP-BPF SANDBOX ISOLATION AUDITOR...${C_RESET}\n"
    echo -e "${C_WHITE}${C_BOLD}--- SECCOMP SUPPORT STATUS ---${C_RESET}"
    if [ -f /proc/sys/kernel/seccomp ]; then
        echo -e "  ${C_GREEN}[✔] Kernel Seccomp subsystem active.${C_RESET}"
    fi
    echo ""
    echo -e "${C_WHITE}${C_BOLD}--- PROCESS SECCOMP ENFORCEMENT SAMPLER ---${C_RESET}"
    local strict=0; local filter=0; local disabled=0
    for status in /proc/[0-9]*/status; do
        local mode; mode=$(grep -i '^Seccomp:' "$status" 2>/dev/null | awk '{print $2}')
        case "$mode" in
            1) strict=$((strict + 1)) ;;
            2) filter=$((filter + 1)) ;;
            0) disabled=$((disabled + 1)) ;;
        esac
    done
    echo -e "  ${C_GREEN}[*] Strict Mode (1):${C_RESET}     $strict processes"
    echo -e "  ${C_CYAN}[*] Filter Mode (2):${C_RESET}     $filter processes (sandboxed with BPF)"
    echo -e "  ${C_YELLOW}[*] Disabled Mode (0):${C_RESET}   $disabled processes (unrestricted syscalls)"
    echo ""
}

cmd_tty_snoop_detect() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX TTY / PTY SNOOPING & INJECTION AUDITOR...${C_RESET}\n"
    echo -e "${C_WHITE}${C_BOLD}--- TIOCSTI IOCTL INJECTION PROTECTION ---${C_RESET}"
    if [ -f /proc/sys/dev/tty/legacy_tiocsti ]; then
        local val; val=$(cat /proc/sys/dev/tty/legacy_tiocsti 2>/dev/null)
        if [ "$val" -eq 0 ]; then
            echo -e "  ${C_GREEN}[✔] legacy_tiocsti = 0 (TIOCSTI injection disabled - Protected)${C_RESET}"
        else
            echo -e "  ${C_RED}[!] legacy_tiocsti = $val (TIOCSTI injection enabled - Vulnerable to TTY hijacking)${C_RESET}"
        fi
    else
        echo -e "  ${C_GRAY}[i] legacy_tiocsti sysctl not exposed in this kernel build.${C_RESET}"
    fi
    echo ""
    echo -e "${C_WHITE}${C_BOLD}--- ACTIVE PSEUDO-TERMINALS (/dev/pts) ---${C_RESET}"
    if [ -d /dev/pts ]; then
        ls -la /dev/pts/ 2>/dev/null | grep -v 'ptmx\|total' | while read -r line; do
            echo -e "  $line"
        done
    fi
    echo ""
}

cmd_kexec_lockdown() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX KERNEL LOCKDOWN & KEXEC INTEGRITY AUDITOR...${C_RESET}\n"
    echo -e "${C_WHITE}${C_BOLD}--- LINUX KERNEL LOCKDOWN STATE ---${C_RESET}"
    if [ -f /sys/kernel/security/lockdown ]; then
        local lstate; lstate=$(cat /sys/kernel/security/lockdown 2>/dev/null)
        echo -e "  Lockdown mode: ${C_YELLOW}$lstate${C_RESET}"
        if echo "$lstate" | grep -q '\[integrity\]\|\[confidentiality\]'; then
            echo -e "  ${C_GREEN}[✔] Kernel lockdown is active.${C_RESET}"
        else
            echo -e "  ${C_YELLOW}[!] Kernel lockdown is in 'none' state.${C_RESET}"
        fi
    else
        echo -e "  ${C_GRAY}[i] /sys/kernel/security/lockdown not supported by host kernel.${C_RESET}"
    fi
    echo ""
    echo -e "${C_WHITE}${C_BOLD}--- KEXEC HOT-REPLACE HARDENING ---${C_RESET}"
    if [ -f /proc/sys/kernel/kexec_load_disabled ]; then
        local kdis; kdis=$(cat /proc/sys/kernel/kexec_load_disabled 2>/dev/null)
        if [ "$kdis" -eq 1 ]; then
            echo -e "  ${C_GREEN}[✔] kexec_load_disabled = 1 (Kernel cannot be replaced in memory)${C_RESET}"
        else
            echo -e "  ${C_RED}[!] kexec_load_disabled = 0 (kexec_load syscall enabled)${C_RESET}"
        fi
    fi
    echo ""
}

cmd_mem_protect_audit() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX HARDWARE & CPU EXPLOIT MITIGATION AUDITOR...${C_RESET}\n"
    echo -e "${C_WHITE}${C_BOLD}--- CPU HARDWARE MITIGATION FLAGS ---${C_RESET}"
    if [ -f /proc/cpuinfo ]; then
        local flags; flags=$(grep -m 1 "^flags" /proc/cpuinfo 2>/dev/null || echo "")
        echo -n "  SMEP (Supervisor Execution Prevention): "
        echo "$flags" | grep -qw "smep" && echo -e "${C_GREEN}[✔] ENABLED${C_RESET}" || echo -e "${C_RED}[!] MISSING${C_RESET}"
        echo -n "  SMAP (Supervisor Access Prevention):    "
        echo "$flags" | grep -qw "smap" && echo -e "${C_GREEN}[✔] ENABLED${C_RESET}" || echo -e "${C_RED}[!] MISSING${C_RESET}"
        echo -n "  NX/XD (No-Execute Memory Pages):        "
        echo "$flags" | grep -qw "nx" && echo -e "${C_GREEN}[✔] ENABLED${C_RESET}" || echo -e "${C_RED}[!] MISSING${C_RESET}"
    fi
    echo ""
    echo -e "${C_WHITE}${C_BOLD}--- SYSFS VULNERABILITY STATUS ---${C_RESET}"
    if [ -d /sys/devices/system/cpu/vulnerabilities ]; then
        for vuln in /sys/devices/system/cpu/vulnerabilities/*; do
            local vname; vname=$(basename "$vuln")
            local vstat; vstat=$(cat "$vuln" 2>/dev/null)
            if echo "$vstat" | grep -qi 'mitigation\|not affected'; then
                echo -e "  ${C_GREEN}[✔] $vname:${C_RESET} $vstat"
            else
                echo -e "  ${C_RED}[!!] $vname:${C_RESET} $vstat"
            fi
        done
    fi
    echo ""
}

cmd_mount_hardening() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX FILESYSTEM MOUNT HARDENING AUDITOR...${C_RESET}\n"
    echo -e "${C_WHITE}${C_BOLD}--- TEMPORARY & SHARED MOUNT POLICIES ---${C_RESET}"
    for dir in /tmp /dev/shm /var/tmp; do
        if [ -d "$dir" ]; then
            local mnt; mnt=$(grep -E " $dir " /proc/mounts 2>/dev/null | tail -1 || true)
            if [ -n "$mnt" ]; then
                echo -e "  ${C_YELLOW}$dir:${C_RESET} $mnt"
                echo "$mnt" | grep -q "nosuid" && echo -e "    ${C_GREEN}[✔] nosuid enforced${C_RESET}" || echo -e "    ${C_RED}[!] Missing nosuid${C_RESET}"
                echo "$mnt" | grep -q "noexec" && echo -e "    ${C_GREEN}[✔] noexec enforced${C_RESET}" || echo -e "    ${C_YELLOW}[!] Missing noexec${C_RESET}"
                echo "$mnt" | grep -q "nodev" && echo -e "    ${C_GREEN}[✔] nodev enforced${C_RESET}" || echo -e "    ${C_RED}[!] Missing nodev${C_RESET}"
            else
                echo -e "  ${C_YELLOW}$dir:${C_RESET} Not on separate mount partition."
            fi
        fi
    done
    echo ""
}

cmd_ipc_audit() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX IPC SHARED MEMORY & QUEUE AUDITOR...${C_RESET}\n"
    echo -e "${C_WHITE}${C_BOLD}--- SHARED MEMORY SEGMENTS (ipcs -m) ---${C_RESET}"
    if command -v ipcs >/dev/null 2>&1; then
        ipcs -m 2>/dev/null | head -n 25
        echo ""
        echo -e "${C_WHITE}${C_BOLD}--- MESSAGE QUEUES & SEMAPHORES ---${C_RESET}"
        ipcs -q 2>/dev/null | head -n 15
        ipcs -s 2>/dev/null | head -n 15
    else
        echo -e "${C_YELLOW}[!] ipcs command not found. Inspecting /dev/shm...${C_RESET}"
        ls -la /dev/shm 2>/dev/null
    fi
    echo ""
}

cmd_dmesg_exploit() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX KERNEL EXPLOIT & CORRUPTION DETECTOR...${C_RESET}\n"
    echo -e "${C_WHITE}${C_BOLD}--- SCANNING DMESG FOR EXPLOIT SIGNATURES ---${C_RESET}"
    local exp_log
    exp_log=$(dmesg 2>/dev/null | grep -Eic 'general protection fault|kernel stack corrupted|stack-protector|refcount_t overflow|poison overwritten|Slab corruption|unable to handle kernel paging' || echo "0")
    if [ "$exp_log" -gt 0 ] 2>/dev/null; then
        echo -e "  ${C_RED}[!!] DETECTED $exp_log SUSPICIOUS MEMORY/EXPLOIT EVENTS IN DMESG!${C_RESET}\n"
        dmesg 2>/dev/null | grep -Ei 'general protection fault|kernel stack corrupted|stack-protector|refcount_t overflow|poison overwritten|Slab corruption|unable to handle kernel paging' | tail -n 25
    else
        echo -e "  ${C_GREEN}[✔] Zero kernel memory corruption / exploit patterns detected in ring buffer.${C_RESET}"
    fi
    echo ""
}

cmd_root_jail() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX EPHEMERAL ROOT NAMESPACE SANDBOX JAIL...${C_RESET}\n"
    if ! command -v unshare >/dev/null 2>&1; then
        echo -e "${C_RED}[!] 'unshare' utility not available on host.${C_RESET}"; return 1
    fi
    echo -e "${C_YELLOW}[*] Spawning isolated sandbox (PID, Mount, IPC, UTS, Network namespaces)...${C_RESET}"
    echo -e "${C_GRAY}[i] Type 'exit' to terminate jail and destroy container state.${C_RESET}\n"
    unshare --mount --uts --ipc --pid --fork --mount-proc /bin/bash 2>/dev/null || \
        unshare --user --mount --pid --fork /bin/bash 2>/dev/null || \
        echo -e "${C_RED}[!] Could not create isolated namespace jail (needs root or user namespaces).${C_RESET}"
    echo -e "\n${C_GREEN}[✔] Namespace sandbox session terminated.${C_RESET}\n"
}

cmd_core_dump_audit() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX PROCESS CORE DUMP & MEMORY LEAK POLICY AUDIT...${C_RESET}\n"
    echo -e "${C_WHITE}${C_BOLD}--- CORE PATTERN HANDLER ---${C_RESET}"
    if [ -f /proc/sys/kernel/core_pattern ]; then
        local pattern; pattern=$(cat /proc/sys/kernel/core_pattern 2>/dev/null)
        echo -e "  core_pattern: ${C_YELLOW}$pattern${C_RESET}"
        if echo "$pattern" | grep -q '^|'; then
            echo -e "  ${C_YELLOW}[*] Core dumps piped to userland handler.${C_RESET}"
        elif [ -z "$pattern" ]; then
            echo -e "  ${C_GREEN}[✔] Core dumps disabled.${C_RESET}"
        fi
    fi
    echo ""
    echo -e "${C_WHITE}${C_BOLD}--- SUID PROCESS DUMP PRIVILEGE (fs.suid_dumpable) ---${C_RESET}"
    if [ -f /proc/sys/fs/suid_dumpable ]; then
        local sd; sd=$(cat /proc/sys/fs/suid_dumpable 2>/dev/null)
        if [ "$sd" -eq 0 ]; then
            echo -e "  ${C_GREEN}[✔] fs.suid_dumpable = 0 (SUID processes cannot be dumped - Secure)${C_RESET}"
        else
            echo -e "  ${C_RED}[!] fs.suid_dumpable = $sd (SUID core dumping enabled - Memory leak risk!)${C_RESET}"
        fi
    fi
    echo ""
}

