cmd_anti_rev() {
    if run_native_bin "anti-reverse-sentinel" "$@"; then
        return 0
    fi
    local ax_root
    ax_root=$(find_asterix_root)
    for candidate in \
        "${ax_root}/packages/Asterix-Anti-Network-Attack/ASTERIX-ANTI-NETWORK ATTACK/anti-reverse-sentinel/target/release/anti-reverse-sentinel" \
        "${ax_root}/packages/Asterix-Anti-Network-Attack/anti-reverse-sentinel/target/release/anti-reverse-sentinel" \
        "${ax_root}/packages/Asterix-Anti-Network-Attack/anti-reverse-sentinel/anti-reverse-sentinel"; do
        if [ -x "$candidate" ]; then
            "$candidate" "$@"
            return 0
        fi
    done

    echo -e "${C_CYAN}[*] Running Anti-Reverse Inspection...${C_RESET}"
    if grep -qi "TracerPid:[[:space:]]*[1-9]" /proc/self/status 2>/dev/null; then
        echo -e "  ${C_RED}[!!] Process is being traced by a debugger!${C_RESET}"
    else
        echo -e "  ${C_GREEN}[✔] Zero ptrace debuggers attached (TracerPid = 0).${C_RESET}"
    fi
    if [ -n "$LD_PRELOAD" ]; then
        echo -e "  ${C_RED}[!!] Suspicious LD_PRELOAD injection detected: $LD_PRELOAD${C_RESET}"
    else
        echo -e "  ${C_GREEN}[✔] Zero LD_PRELOAD injection vectors.${C_RESET}"
    fi
}

cmd_pkg() {
    local script
    script=$(find_helper_script "ax-pkg-sync.sh")
    if [ -n "$script" ]; then
        bash "$script" "$@"
    else
        echo -e "${C_RED}[!] scripts-hub/ax-pkg-sync.sh not found.${C_RESET}"
    fi
}

