    local helper
    helper=$(find_helper_script "ax-darktrace.sh")
    if [ -n "$helper" ] && [ -f "$helper" ]; then
        bash "$helper" "$@"
        return $?
    elif run_native_bin "asterix-dark-engine" "$@"; then
        return 0
    else
        echo -e "${C_RED}[!] ax-darktrace.sh and asterix-dark-engine not found.${C_RESET}"
        return 1
    fi
}

