cmd_proxychains() {
    local ax_root
    ax_root=$(find_asterix_root)
    local pc_dir=""
    if [ -n "$ax_root" ] && [ -d "${ax_root}/proxychains-creator" ]; then
        pc_dir="${ax_root}/proxychains-creator"
    elif [ -d "/etc/asterix/proxychains-creator" ]; then
        pc_dir="/etc/asterix/proxychains-creator"
    elif [ -d "proxychains-creator" ]; then
        pc_dir="proxychains-creator"
    elif [ -d "$HOME/asterix/proxychains-creator" ]; then
        pc_dir="$HOME/asterix/proxychains-creator"
    fi

    if [ -z "$pc_dir" ]; then
        echo -e "${C_RED}[!] Error: proxychains-creator directory not located.${C_RESET}"
        return 1
    fi

    if command -v python3 >/dev/null 2>&1 && python3 --version >/dev/null 2>&1 && [ -f "${pc_dir}/proxy_manager.py" ]; then
        python3 "${pc_dir}/proxy_manager.py" "$@"
    elif [ -f "${pc_dir}/proxy_manager.sh" ]; then
        bash "${pc_dir}/proxy_manager.sh" "$@"
    else
        echo -e "${C_RED}[!] Error: Neither proxy_manager.py nor proxy_manager.sh found in ${pc_dir}.${C_RESET}"
        return 1
    fi
}


