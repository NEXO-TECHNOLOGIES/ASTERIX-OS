# ---------------------------------------------------------------------
# Subsystem Dispatches to asterix-loader
# ---------------------------------------------------------------------

dispatch_loader() {
    local flag="$1"
    shift || true
    if command -v asterix-loader >/dev/null 2>&1; then
        exec asterix-loader "$flag" "$@"
    elif [ -x "/usr/local/bin/asterix-loader" ]; then
        exec /usr/local/bin/asterix-loader "$flag" "$@"
    elif [ -x "ui-core/asterix-loader/target/release/asterix-loader" ]; then
        exec ui-core/asterix-loader/target/release/asterix-loader "$flag" "$@"
    else
        echo -e "${C_YELLOW}[!] asterix-loader not yet compiled. Running fast fallback...${C_RESET}"
        if [ -f "/etc/asterix/loading_screen.sh" ]; then
            exec /etc/asterix/loading_screen.sh
        fi
    fi
}

# ---------------------------------------------------------------------
# Universal Dynamic System Wrapper (Thousands of System Tools)
# ---------------------------------------------------------------------

dynamic_system_exec() {
    local cmd="$1"
    shift || true
    if command -v "$cmd" >/dev/null 2>&1; then
        echo -e "${C_CYAN}[*] ASTERIX Omni-Exec: ${C_WHITE}${cmd} ${*}${C_RESET}"
        local start_ts
        start_ts=$(date +%s%N 2>/dev/null || date +%s)
        "$cmd" "$@"
        local rc=$?
        local end_ts
        end_ts=$(date +%s%N 2>/dev/null || date +%s)
        if [ $rc -eq 0 ]; then
            echo -e "\n${C_GREEN}[✔] ${cmd} finished successfully.${C_RESET}"
        else
            echo -e "\n${C_YELLOW}[!] ${cmd} exited with status ${rc}.${C_RESET}"
        fi
        return $rc
    else
        echo -e "${C_RED}[!] Command '${cmd}' not recognized in ASTERIX OS.${C_RESET}"
        echo -e "${C_YELLOW}[*] Try installing it via: ${C_WHITE}ax install ${cmd}${C_RESET}"
        echo -e "${C_GRAY}[i] Type 'ax list' to browse all native suites or 'ax help' for reference.${C_RESET}"
        return 127
    fi
}

