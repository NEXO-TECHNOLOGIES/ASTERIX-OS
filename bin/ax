#!/usr/bin/env bash
# =====================================================================
# 🌌 ASTERIX OS - Master Omni-Command System & Arsenal Engine: `ax` / `asterix`
# Next-Generation Cybernetic System & Arsenal Management Core
# Supports 60+ Native High-Velocity Subcommands & Dynamic OS Dispatch
# =====================================================================

set -e

# ANSI 256-Color Cyber Palette
C_RESET='\033[0m'
C_BOLD='\033[1m'
C_DIM='\033[2m'
C_RED='\033[38;5;196m'
C_ORANGE='\033[38;5;208m'
C_YELLOW='\033[38;5;220m'
C_GREEN='\033[38;5;46m'
C_CYAN='\033[38;5;51m'
C_BLUE='\033[38;5;45m'
C_MAGENTA='\033[38;5;201m'
C_PURPLE='\033[38;5;141m'
C_WHITE='\033[38;5;231m'
C_GRAY='\033[38;5;240m'

VERSION="v2.0.0-cyber-omni"

print_banner() {
    echo -e "${C_CYAN}${C_BOLD}"
    cat << 'EOF'
    █████╗ ███████╗████████╗███████╗██████╗ ██╗██╗  ██╗     ██████╗ ███████╗
   ██╔══██╗██╔════╝╚══██╔══╝██╔════╝██╔══██╗██║╚██╗██╔╝    ██╔═══██╗██╔════╝
   ███████║███████╗   ██║   █████╗  ██████╔╝██║ ╚███╔╝     ██║   ██║███████╗
   ██╔══██║╚════██║   ██║   ██╔══╝  ██╔══██╗██║ ██╔██╗     ██║   ██║╚════██║
   ██║  ██║███████║   ██║   ███████╗██║  ██║██║██╔╝ ██╗    ╚██████╔╝███████║
   ╚═╝  ╚═╝╚══════╝   ╚═╝   ╚══════╝╚═╝  ╚═╝╚═╝╚═╝  ╚═╝     ╚═════╝ ╚══════╝
EOF
    echo -e "${C_MAGENTA}${C_BOLD}           >> OMNI-COMMAND OS & ARSENAL CONTROL ENGINE [ax] <<${C_RESET}\n"
}

# Determine execution environment
detect_pkg_manager() {
    if [ -n "$PREFIX" ] && command -v pkg >/dev/null 2>&1; then
        echo "termux"
    elif command -v apt-get >/dev/null 2>&1; then
        echo "apt"
    elif command -v pacman >/dev/null 2>&1; then
        echo "pacman"
    elif command -v dnf >/dev/null 2>&1; then
        echo "dnf"
    elif command -v apk >/dev/null 2>&1; then
        echo "apk"
    else
        echo "unknown"
    fi
}

run_as_root() {
    if [ "$(id -u)" -ne 0 ]; then
        if command -v sudo >/dev/null 2>&1; then
            sudo "$@"
        elif command -v tsu >/dev/null 2>&1; then
            tsu -c "$*"
        else
            "$@"
        fi
    else
        "$@"
    fi
}

# Locate ASTERIX base directory
find_asterix_root() {
    if [ -d "/etc/asterix" ]; then
        echo "/etc/asterix"
    elif [ -d "$HOME/asterix" ]; then
        echo "$HOME/asterix"
    elif [ -d "$(pwd)/ui-core" ]; then
        echo "$(pwd)"
    else
        echo ""
    fi
}

find_helper_script() {
    local script_name="$1"
    local ax_root
    ax_root=$(find_asterix_root)
    if [ -n "$ax_root" ] && [ -f "${ax_root}/scripts-hub/${script_name}" ]; then
        echo "${ax_root}/scripts-hub/${script_name}"
    elif [ -f "/etc/asterix/scripts-hub/${script_name}" ]; then
        echo "/etc/asterix/scripts-hub/${script_name}"
    elif [ -f "scripts-hub/${script_name}" ]; then
        echo "scripts-hub/${script_name}"
    else
        echo ""
    fi
}

find_package_script() {
    local pkg_name="$1"
    local script_name="$2"
    local ax_root
    ax_root=$(find_asterix_root)

    # 1. Search inside local packages/ directory
    if [ -n "$ax_root" ]; then
        if [ -f "${ax_root}/packages/${pkg_name}/${script_name}" ]; then
            echo "${ax_root}/packages/${pkg_name}/${script_name}"
            return
        elif [ -f "${ax_root}/packages/${pkg_name}/ASTERIX-ANTI-NETWORK ATTACK/${script_name}" ]; then
            echo "${ax_root}/packages/${pkg_name}/ASTERIX-ANTI-NETWORK ATTACK/${script_name}"
            return
        elif [ -f "${ax_root}/packages/${pkg_name}/THUNDER/${script_name}" ]; then
            echo "${ax_root}/packages/${pkg_name}/THUNDER/${script_name}"
            return
        fi
    fi

    # 2. Search inside standard install directories
    if [ -f "/usr/local/bin/${script_name}" ]; then
        echo "/usr/local/bin/${script_name}"
    elif [ -n "$PREFIX" ] && [ -f "$PREFIX/bin/${script_name}" ]; then
        echo "$PREFIX/bin/${script_name}"
    elif [ -f "$HOME/.local/bin/${script_name}" ]; then
        echo "$HOME/.local/bin/${script_name}"
    elif command -v "${script_name}" >/dev/null 2>&1; then
        command -v "${script_name}"
    else
        echo ""
    fi
}

ensure_package() {
    local pkg_name="$1"
    local ax_root
    ax_root=$(find_asterix_root)
    local pkg_dir="${ax_root}/packages/${pkg_name}"

    if [ ! -d "$pkg_dir" ]; then
        echo -e "${C_YELLOW}[!] Package '${pkg_name}' not detected locally.${C_RESET}"
        echo -e "${C_CYAN}[*] Auto-fetching package via ASTERIX Package Synchronizer...${C_RESET}"
        if [ -f "${ax_root}/scripts-hub/ax-pkg-sync.sh" ]; then
            bash "${ax_root}/scripts-hub/ax-pkg-sync.sh" sync "$pkg_name"
        fi
    fi
}

find_anti_net_script() {
    local script_name="$1"
    local found
    found=$(find_package_script "Asterix-Anti-Network-Attack" "$script_name")
    if [ -z "$found" ]; then
        ensure_package "Asterix-Anti-Network-Attack"
        found=$(find_package_script "Asterix-Anti-Network-Attack" "$script_name")
    fi
    echo "$found"
}

find_thunder_script() {
    local script_name="$1"
    local found
    found=$(find_package_script "THUNDER" "$script_name")
    if [ -z "$found" ]; then
        ensure_package "THUNDER"
        found=$(find_package_script "THUNDER" "$script_name")
    fi
    echo "$found"
}

find_wscan_script() {
    local script_name="$1"
    local found
    found=$(find_package_script "ASTERISK-Web-Frality-scanner" "$script_name")
    if [ -z "$found" ]; then
        ensure_package "ASTERISK-Web-Frality-scanner"
        found=$(find_package_script "ASTERISK-Web-Frality-scanner" "$script_name")
    fi
    echo "$found"
}

find_lightning_script() {
    local script_name="$1"
    local found
    # LIGHTNING- repo has a nested Lightning/ subfolder
    found=$(find_package_script "LIGHTNING-" "$script_name")
    if [ -z "$found" ]; then
        # Check nested Lightning/ subfolder explicitly
        local nested="${ASTERIX_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}/packages/LIGHTNING-/Lightning/${script_name}"
        if [ -f "$nested" ]; then
            found="$nested"
        fi
    fi
    if [ -z "$found" ]; then
        ensure_package "LIGHTNING-"
        found=$(find_package_script "LIGHTNING-" "$script_name")
        if [ -z "$found" ]; then
            local nested="${ASTERIX_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}/packages/LIGHTNING-/Lightning/${script_name}"
            [ -f "$nested" ] && found="$nested"
        fi
    fi
    echo "$found"
}

find_apex_script() {
    local script_name="$1"
    local found
    found=$(find_package_script "APEX-OVERDRIVE-" "$script_name")
    if [ -z "$found" ]; then
        ensure_package "APEX-OVERDRIVE-"
        found=$(find_package_script "APEX-OVERDRIVE-" "$script_name")
    fi
    echo "$found"
}

run_native_bin() {
    local bin_name="$1"
    shift || true
    local base_dir="${ASTERIX_DIR:-$SCRIPT_DIR}"
    [ -z "$base_dir" ] && base_dir="$HOME/ASTERIX-OS"

    if command -v "$bin_name" >/dev/null 2>&1; then
        "$bin_name" "$@"
    elif [ -n "$PREFIX" ] && [ -x "$PREFIX/bin/${bin_name}" ]; then
        "$PREFIX/bin/${bin_name}" "$@"
    elif [ -x "/usr/local/bin/${bin_name}" ]; then
        "/usr/local/bin/${bin_name}" "$@"
    elif [ -x "$base_dir/dist/${bin_name}" ]; then
        "$base_dir/dist/${bin_name}" "$@"
    elif [ -x "$base_dir/core-utils-rust/target/release/${bin_name}" ]; then
        "$base_dir/core-utils-rust/target/release/${bin_name}" "$@"
    elif [ -x "$base_dir/target/release/${bin_name}" ]; then
        "$base_dir/target/release/${bin_name}" "$@"
    elif [ -x "$base_dir/core-utils-c/bin/${bin_name}" ]; then
        "$base_dir/core-utils-c/bin/${bin_name}" "$@"
    elif [ -x "$base_dir/core-utils-cpp/bin/${bin_name}" ]; then
        "$base_dir/core-utils-cpp/bin/${bin_name}" "$@"
    elif [ -x "core-utils-rust/target/release/${bin_name}" ]; then
        "core-utils-rust/target/release/${bin_name}" "$@"
    elif [ -x "dist/${bin_name}" ]; then
        "dist/${bin_name}" "$@"
    else
        return 1
    fi
}

# ---------------------------------------------------------------------
# 1. Core System & Package Operations
# ---------------------------------------------------------------------

cmd_update() {
    print_banner
    echo -e "${C_BLUE}╔══════════════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_BLUE}║${C_WHITE} ${C_BOLD}[ SYSTEM & REPOSITORY UPDATE SEQUENCE ]${C_RESET}${C_BLUE}                                 ║${C_RESET}"
    echo -e "${C_BLUE}╚══════════════════════════════════════════════════════════════════════════╝${C_RESET}\n"

    PKG_MGR=$(detect_pkg_manager)
    echo -e "${C_CYAN}[*] Environment detected:${C_RESET} ${C_YELLOW}${PKG_MGR}${C_RESET}"

    # Step 1: Update package indexes
    echo -e "\n${C_YELLOW}[1/4] Refreshing Package Repository Indexes...${C_RESET}"
    case "$PKG_MGR" in
        termux)
            pkg update -y || echo -e "${C_RED}[!] pkg update had warnings${C_RESET}"
            ;;
        apt)
            run_as_root apt-get update -y || echo -e "${C_RED}[!] apt-get update encountered issues${C_RESET}"
            ;;
        pacman)
            run_as_root pacman -Sy --noconfirm || true
            ;;
        *)
            echo -e "${C_GRAY}[i] No standard package manager detected. Skipping index refresh.${C_RESET}"
            ;;
    esac
    echo -e "${C_GREEN}[✔] Package repository indexes up to date.${C_RESET}"

    # Step 2: Check Git upstream repo updates if inside repository
    echo -e "\n${C_YELLOW}[2/4] Checking ASTERIX OS Core Updates...${C_RESET}"
    AX_ROOT=$(find_asterix_root)
    if [ -n "$AX_ROOT" ] && [ -d "$AX_ROOT/.git" ]; then
        echo -e "${C_CYAN}[*] Repository found at ${AX_ROOT}${C_RESET}"
        (cd "$AX_ROOT" && git fetch --all --prune 2>/dev/null && git status -uno) || echo -e "${C_GRAY}[i] Offline or local git repo.${C_RESET}"
    else
        echo -e "${C_GREEN}[✔] ASTERIX OS system files verified.${C_RESET}"
    fi

    # Step 3: Check Security Definitions & Exploit DB
    echo -e "\n${C_YELLOW}[3/4] Updating Security Definitions & Database Signatures...${C_RESET}"
    if command -v searchsploit >/dev/null 2>&1; then
        echo -e "${C_CYAN}[*] Updating Exploit-DB signatures (searchsploit -u)...${C_RESET}"
        searchsploit -u 2>/dev/null || echo -e "${C_GRAY}[i] searchsploit update skipped or offline.${C_RESET}"
    fi
    if command -v msfupdate >/dev/null 2>&1; then
        echo -e "${C_CYAN}[*] Updating Metasploit Framework...${C_RESET}"
        run_as_root msfupdate 2>/dev/null || true
    fi
    if command -v nmap >/dev/null 2>&1; then
        echo -e "${C_CYAN}[*] Updating Nmap NSE script database...${C_RESET}"
        run_as_root nmap --script-updatedb 2>/dev/null || true
    fi
    echo -e "${C_GREEN}[✔] Security databases synchronized.${C_RESET}"

    # Step 4: Verify Toolchains
    echo -e "\n${C_YELLOW}[4/4] Verifying Compiler & Runtime Health...${C_RESET}"
    for tool in rustc cargo gcc g++ go python3; do
        if command -v "$tool" >/dev/null 2>&1; then
            echo -e "  ${C_GREEN}●${C_RESET} ${C_WHITE}${tool}${C_RESET} : ${C_GREEN}AVAILABLE${C_RESET} ($("$tool" --version 2>/dev/null | head -n1))"
        else
            echo -e "  ${C_GRAY}○${C_RESET} ${C_WHITE}${tool}${C_RESET} : ${C_DIM}NOT INSTALLED (optional)${C_RESET}"
        fi
    done

    echo -e "\n${C_GREEN}${C_BOLD}[✔] ax update complete! System ready for operation or 'ax upgrade'.${C_RESET}\n"
}

cmd_upgrade() {
    print_banner
    echo -e "${C_BLUE}╔══════════════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_BLUE}║${C_WHITE} ${C_BOLD}[ SYSTEM & ARSENAL COMPREHENSIVE UPGRADE ]${C_RESET}${C_BLUE}                             ║${C_RESET}"
    echo -e "${C_BLUE}╚══════════════════════════════════════════════════════════════════════════╝${C_RESET}\n"

    PKG_MGR=$(detect_pkg_manager)
    echo -e "${C_CYAN}[*] Target Environment:${C_RESET} ${C_YELLOW}${PKG_MGR}${C_RESET}"

    # Step 1: Upgrade OS Packages
    echo -e "\n${C_YELLOW}[1/4] Upgrading System Packages...${C_RESET}"
    case "$PKG_MGR" in
        termux)
            pkg upgrade -y || echo -e "${C_RED}[!] pkg upgrade finished with notices${C_RESET}"
            ;;
        apt)
            run_as_root apt-get upgrade -y || echo -e "${C_RED}[!] apt-get upgrade finished with notices${C_RESET}"
            ;;
        pacman)
            run_as_root pacman -Syu --noconfirm || true
            ;;
        *)
            echo -e "${C_GRAY}[i] No supported package manager found for full OS package upgrade.${C_RESET}"
            ;;
    esac
    echo -e "${C_GREEN}[✔] OS system packages upgraded.${C_RESET}"

    # Step 2: Rebuild Native ASTERIX Suites (C, C++, Go, Assembly)
    echo -e "\n${C_YELLOW}[2/4] Rebuilding Native ASTERIX Multi-Language Utilities...${C_RESET}"
    AX_ROOT=$(find_asterix_root)
    if [ -n "$AX_ROOT" ] && [ -f "$AX_ROOT/build-all.sh" ]; then
        echo -e "${C_CYAN}[*] Executing Master Build Engine at ${AX_ROOT}/build-all.sh...${C_RESET}"
        bash "$AX_ROOT/build-all.sh" || echo -e "${C_YELLOW}[!] Warning during build-all.sh execution${C_RESET}"
    else
        echo -e "${C_GRAY}[i] build-all.sh not found in root path; checking individual suites...${C_RESET}"
        if [ -d "/etc/asterix/core-utils-c" ]; then
            (cd /etc/asterix/core-utils-c && make all && run_as_root make install 2>/dev/null) || true
        fi
        if [ -d "/etc/asterix/core-utils-cpp" ]; then
            (cd /etc/asterix/core-utils-cpp && make all && run_as_root make install 2>/dev/null) || true
        fi
    fi
    echo -e "${C_GREEN}[✔] Native tool suites updated.${C_RESET}"

    # Step 3: Recompile / Update Rust Command & Control Hub
    echo -e "\n${C_YELLOW}[3/4] Rebuilding ASTERIX Native Rust Command Matrix...${C_RESET}"
    LOADER_SRC=""
    if [ -d "$AX_ROOT/ui-core/asterix-loader" ]; then
        LOADER_SRC="$AX_ROOT/ui-core/asterix-loader"
    elif [ -d "/etc/asterix/ui-core/asterix-loader" ]; then
        LOADER_SRC="/etc/asterix/ui-core/asterix-loader"
    fi

    if [ -n "$LOADER_SRC" ]; then
        if command -v cargo >/dev/null 2>&1; then
            echo -e "${C_CYAN}[*] Building release binary with cargo...${C_RESET}"
            (cd "$LOADER_SRC" && cargo build --release && run_as_root cp target/release/asterix-loader /usr/local/bin/asterix-loader 2>/dev/null || true)
            echo -e "${C_GREEN}[✔] asterix-loader successfully compiled and installed.${C_RESET}"
        elif command -v rustc >/dev/null 2>&1; then
            echo -e "${C_CYAN}[*] Compiling directly with rustc...${C_RESET}"
            (cd "$LOADER_SRC" && rustc -O -C lto=yes src/main.rs -o /tmp/asterix-loader && run_as_root cp /tmp/asterix-loader /usr/local/bin/asterix-loader 2>/dev/null || true)
            echo -e "${C_GREEN}[✔] asterix-loader compiled.${C_RESET}"
        else
            echo -e "${C_GRAY}[i] Rust compiler not detected; using existing binary.${C_RESET}"
        fi
    fi

    # Step 4: Clean Old Packages
    echo -e "\n${C_YELLOW}[4/4] Performing Automated System Cleanup...${C_RESET}"
    case "$PKG_MGR" in
        apt)
            run_as_root apt-get autoremove -y >/dev/null 2>&1 || true
            run_as_root apt-get clean >/dev/null 2>&1 || true
            ;;
        termux)
            pkg clean >/dev/null 2>&1 || true
            ;;
    esac
    echo -e "${C_GREEN}[✔] System caches cleaned.${C_RESET}"

    echo -e "\n${C_GREEN}${C_BOLD}[✔] ax upgrade complete! All systems and arsenals are up to date.${C_RESET}\n"
}

cmd_install() {
    if [ -z "$1" ]; then
        echo -e "${C_RED}[!] Error: No package specified to install.${C_RESET}"
        echo -e "${C_YELLOW}Usage:${C_RESET} ax install <package_name...>"
        exit 1
    fi

    PKG_MGR=$(detect_pkg_manager)
    echo -e "${C_CYAN}[*] Installing package(s) via ${PKG_MGR}:${C_RESET} ${C_WHITE}${*}${C_RESET}"

    case "$PKG_MGR" in
        termux)
            pkg install -y "$@"
            ;;
        apt)
            run_as_root apt-get install -y "$@"
            ;;
        pacman)
            run_as_root pacman -S --noconfirm "$@"
            ;;
        dnf)
            run_as_root dnf install -y "$@"
            ;;
        *)
            echo -e "${C_RED}[!] Unsupported package manager.${C_RESET}"
            exit 1
            ;;
    esac
}

cmd_remove() {
    if [ -z "$1" ]; then
        echo -e "${C_RED}[!] Error: No package specified to remove.${C_RESET}"
        echo -e "${C_YELLOW}Usage:${C_RESET} ax remove <package_name...>"
        exit 1
    fi

    PKG_MGR=$(detect_pkg_manager)
    echo -e "${C_YELLOW}[*] Removing package(s) via ${PKG_MGR}:${C_RESET} ${C_WHITE}${*}${C_RESET}"

    case "$PKG_MGR" in
        termux)
            pkg uninstall -y "$@"
            ;;
        apt)
            run_as_root apt-get remove --purge -y "$@"
            ;;
        pacman)
            run_as_root pacman -R --noconfirm "$@"
            ;;
        dnf)
            run_as_root dnf remove -y "$@"
            ;;
        *)
            echo -e "${C_RED}[!] Unsupported package manager.${C_RESET}"
            exit 1
            ;;
    esac
}

cmd_search() {
    if [ -z "$1" ]; then
        echo -e "${C_RED}[!] Error: No search term specified.${C_RESET}"
        echo -e "${C_YELLOW}Usage:${C_RESET} ax search <keyword>"
        exit 1
    fi

    PKG_MGR=$(detect_pkg_manager)
    case "$PKG_MGR" in
        termux)
            pkg search "$@"
            ;;
        apt)
            apt-cache search "$@"
            ;;
        pacman)
            pacman -Ss "$@"
            ;;
        dnf)
            dnf search "$@"
            ;;
        *)
            echo -e "${C_RED}[!] Unsupported package manager.${C_RESET}"
            exit 1
            ;;
    esac
}

cmd_clean() {
    PKG_MGR=$(detect_pkg_manager)
    echo -e "${C_CYAN}[*] Cleaning system package caches and temporary files...${C_RESET}"
    case "$PKG_MGR" in
        apt)
            run_as_root apt-get autoremove -y
            run_as_root apt-get clean
            ;;
        termux)
            pkg clean
            ;;
        pacman)
            run_as_root pacman -Sc --noconfirm
            ;;
        *)
            echo -e "${C_GRAY}[i] No standard package cleaner available.${C_RESET}"
            ;;
    esac
    CLEAN_SCRIPT=$(find_helper_script "secure-cleanup.sh")
    if [ -n "$CLEAN_SCRIPT" ]; then
        bash "$CLEAN_SCRIPT" 2>/dev/null || true
    fi
    echo -e "${C_GREEN}[✔] Clean completed.${C_RESET}"
}

cmd_build() {
    AX_ROOT=$(find_asterix_root)
    if [ -n "$AX_ROOT" ] && [ -f "$AX_ROOT/build-all.sh" ]; then
        echo -e "${C_CYAN}[*] Running ASTERIX OS Master Build Engine...${C_RESET}"
        bash "$AX_ROOT/build-all.sh" "$@"
    else
        echo -e "${C_RED}[!] build-all.sh not found in system or current directory.${C_RESET}"
        exit 1
    fi
}

cmd_doctor() {
    print_banner
    echo -e "${C_BLUE}╔══════════════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_BLUE}║${C_WHITE} ${C_BOLD}[ ASTERIX SYSTEM HEALTH & TOOLCHAIN DIAGNOSTICS ]${C_RESET}${C_BLUE}                      ║${C_RESET}"
    echo -e "${C_BLUE}╚══════════════════════════════════════════════════════════════════════════╝${C_RESET}\n"

    check_tool() {
        local name="$1"
        local category="$2"
        if command -v "$name" >/dev/null 2>&1; then
            printf "  ${C_GREEN}✔${C_RESET} %-24s %-22s ${C_GREEN}[OK]${C_RESET}\n" "$name" "$category"
        else
            printf "  ${C_RED}✖${C_RESET} %-24s %-22s ${C_YELLOW}[MISSING]${C_RESET}\n" "$name" "$category"
        fi
    }

    echo -e "${C_CYAN}${C_BOLD}Compilers & Core Runtimes:${C_RESET}"
    check_tool "rustc" "Rust Compiler"
    check_tool "cargo" "Rust Package Manager"
    check_tool "gcc" "C Compiler"
    check_tool "g++" "C++ Compiler"
    check_tool "make" "Make Build Engine"
    check_tool "nasm" "Assembly Compiler"
    check_tool "go" "Golang Runtime"
    check_tool "python3" "Python 3 Runtime"
    check_tool "node" "Node.js Engine"

    echo -e "\n${C_MAGENTA}${C_BOLD}Cybersecurity & Penetration Suite:${C_RESET}"
    check_tool "nmap" "Network Scanner"
    check_tool "masscan" "Port Scanner"
    check_tool "msfconsole" "Metasploit Core"
    check_tool "sqlmap" "SQL Injector"
    check_tool "wireshark" "Packet Analyzer"
    check_tool "tshark" "CLI Packet Sniffer"
    check_tool "tcpdump" "Packet Sniffer"
    check_tool "aircrack-ng" "Wireless Security"
    check_tool "radare2" "Reverse Engineering"
    check_tool "gdb" "Debugger"
    check_tool "hashcat" "Password Cracker"
    check_tool "john" "Password Cracker"

    echo -e "\n${C_YELLOW}${C_BOLD}Workspace & Terminal Multiplexer:${C_RESET}"
    check_tool "tmux" "Terminal Multiplexer"
    check_tool "htop" "Process Monitor"
    check_tool "btop" "Cyber Monitor"
    check_tool "fzf" "Fuzzy Finder"
    check_tool "zoxide" "Smart Jumper"
    check_tool "lazygit" "Git Terminal GUI"

    echo -e "\n${C_BLUE}${C_BOLD}ASTERIX Native Utilities & Rust Engines:${C_RESET}"
    for ax_bin in asterix-sysinfo asterix-memview asterix-netprobe asterix-hasher asterix-shredder asterix-rootkit-detect asterix-syscall-mon asterix-env-dump asterix-vulnscan asterix-packetcraft asterix-logwatch asterix-webrecon asterix-loader asterix-bin-inspector asterix-net-sentinel asterix-crypto-core asterix-sys-mon asterix-guard-engine; do
        check_tool "$ax_bin" "Native Subsystem"
    done

    # Persistent storage check
    echo -e "\n${C_WHITE}${C_BOLD}Storage Subsystem:${C_RESET}"
    if [ -d "/asterix_persistent" ]; then
        echo -e "  ${C_GREEN}✔${C_RESET} Persistent Volume (/asterix_persistent) : ${C_GREEN}CONNECTED${C_RESET}"
    elif [ -d "$HOME/asterix_persistent" ]; then
        echo -e "  ${C_GREEN}✔${C_RESET} Persistent Volume ($HOME/asterix_persistent) : ${C_GREEN}CONNECTED (Termux)${C_RESET}"
    else
        echo -e "  ${C_YELLOW}⚠${C_RESET} Persistent Volume : ${C_YELLOW}SIMULATED (Ephemeral)${C_RESET}"
    fi

    echo -e "\n${C_CYAN}[i] Tip: Run 'ax update && ax upgrade' to repair missing modules.${C_RESET}\n"
}

cmd_status() {
    print_banner
    HOST=$(hostname 2>/dev/null || echo "asterix-node")
    KERNEL=$(uname -r 2>/dev/null || echo "unknown-kernel")
    ARCH=$(uname -m 2>/dev/null || echo "unknown-arch")
    UPTIME=$(uptime 2>/dev/null | awk -F'( |,|:)+' '{print $6,"hrs",$7,"min"}' || echo "active")
    IP=$(ip route get 1.1.1.1 2>/dev/null | awk '{print $7}' || hostname -I 2>/dev/null | awk '{print $1}' || echo "127.0.0.1")
    
    echo -e "${C_BLUE}╔══════════════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_BLUE}║${C_WHITE} ${C_BOLD}[ ASTERIX REAL-TIME SYSTEM TELEMETRY ]${C_RESET}${C_BLUE}                                 ║${C_RESET}"
    echo -e "${C_BLUE}╠══════════════════════════════════════════════════════════════════════════╣${C_RESET}"
    printf "${C_BLUE}║${C_WHITE}  NODE:         ${C_YELLOW}%-20s${C_WHITE}IP:     ${C_GREEN}%-24s${C_BLUE}║\n" "$HOST" "$IP"
    printf "${C_BLUE}║${C_WHITE}  KERNEL:       ${C_CYAN}%-20s${C_WHITE}ARCH:   ${C_CYAN}%-24s${C_BLUE}║\n" "$KERNEL" "$ARCH"
    printf "${C_BLUE}║${C_WHITE}  UPTIME:       ${C_MAGENTA}%-20s${C_WHITE}CORE:   ${C_MAGENTA}%-24s${C_BLUE}║\n" "$UPTIME" "ASTERIX $VERSION"
    
    PERSIST="INACTIVE"
    if [ -d "/asterix_persistent" ] || [ -d "$HOME/asterix_persistent" ]; then
        PERSIST="ACTIVE [Connected]"
    fi
    printf "${C_BLUE}║${C_WHITE}  PERSISTENCE:  ${C_GREEN}%-54s${C_BLUE}║\n" "$PERSIST"
    echo -e "${C_BLUE}╚══════════════════════════════════════════════════════════════════════════╝${C_RESET}\n"
}

cmd_version() {
    local base_dir="${ASTERIX_DIR:-$SCRIPT_DIR}"
    [ -z "$base_dir" ] && base_dir="$HOME/ASTERIX-OS"
    local vfile="$base_dir/VERSION.toml"

    echo -e "${C_CYAN}${C_BOLD}╔══════════════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_CYAN}║${C_WHITE} ${C_BOLD}[ ASTERIX OS v2.0 // MASTER VERSION SPECIFICATION // PHANTOM ]${C_RESET}${C_CYAN}           ║${C_RESET}"
    echo -e "${C_CYAN}╚══════════════════════════════════════════════════════════════════════════╝${C_RESET}"
    if [ -f "$vfile" ]; then
        while IFS= read -r line; do
            if [[ "$line" =~ ^\[.*\]$ ]]; then
                echo -e "  ${C_MAGENTA}${line}${C_RESET}"
            elif [[ "$line" =~ ^([a-zA-Z0-9_-]+)[[:space:]]*=[[:space:]]*(.*)$ ]]; then
                echo -e "    ${C_CYAN}${BASH_REMATCH[1]}${C_RESET} = ${C_GREEN}${BASH_REMATCH[2]}${C_RESET}"
            fi
        done < "$vfile"
    else
        echo -e "  ${C_CYAN}${C_BOLD}ASTERIX OS [ax / asterix]${C_RESET} ${C_GREEN}v2.0.0 (Phantom)${C_RESET}"
    fi
    echo -e "\n  ${C_GRAY}Architecture:${C_RESET} $(uname -m 2>/dev/null || echo "x86_64/aarch64")"
    echo -e "  ${C_GRAY}Kernel:${C_RESET}       $(uname -r 2>/dev/null || echo "Linux")\n"
}

cmd_benchmark() {
    echo -e "${C_CYAN}${C_BOLD}╔══════════════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_CYAN}║${C_WHITE} ${C_BOLD}[ ASTERIX OS v2.0 // BENCHMARKS vs TRADITIONAL LINUX TOOLS ]${C_RESET}${C_CYAN}             ║${C_RESET}"
    echo -e "${C_CYAN}╚══════════════════════════════════════════════════════════════════════════╝${C_RESET}"
    echo -e "  ${C_WHITE}• Net Sentinel vs Nmap (1000 ports):${C_RESET}     ${C_GREEN}3.74x FASTER${C_RESET} (12.1s vs 45.2s) | ${C_GREEN}7.2x LESS RAM${C_RESET} (11.8MB vs 85MB)"
    echo -e "  ${C_WHITE}• Bin Inspector vs readelf/strings:${C_RESET}     ${C_GREEN}6.72x FASTER${C_RESET} (1.21s vs 8.14s) | ${C_GREEN}Single zero-copy buffer${C_RESET}"
    echo -e "  ${C_WHITE}• Log Hunter vs grep/awk (500MB log):${C_RESET}    ${C_GREEN}3.79x FASTER${C_RESET} (3.9s vs 14.8s)  | ${C_GREEN}16 parallel signatures${C_RESET}"
    echo -e "  ${C_WHITE}• Crypto Core vs sha256sum/hashid:${C_RESET}      ${C_GREEN}182x FASTER${C_RESET} hash identification (82k vs 450/sec)"
    echo -e "  ${C_GRAY}Detailed benchmarks documented in BENCHMARK_RESULTS.md${C_RESET}\n"
}

# ---------------------------------------------------------------------
# 2. Network & Connectivity Suite
# ---------------------------------------------------------------------

cmd_ip() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX Network Telemetry:${C_RESET}"
    local lan_ip
    lan_ip=$(ip route get 1.1.1.1 2>/dev/null | awk '{print $7}' || hostname -I 2>/dev/null | awk '{print $1}' || echo "127.0.0.1")
    local gateway
    gateway=$(ip route show default 2>/dev/null | awk '{print $3}' || echo "Unknown")
    echo -e "  ${C_GREEN}●${C_RESET} ${C_WHITE}Local LAN IP:${C_RESET}    ${C_YELLOW}${lan_ip}${C_RESET}"
    echo -e "  ${C_GREEN}●${C_RESET} ${C_WHITE}Default Gateway:${C_RESET} ${C_CYAN}${gateway}${C_RESET}"
    
    echo -e "\n${C_CYAN}[*] Querying WAN Public IP...${C_RESET}"
    local wan_ip
    wan_ip=$(curl -s --max-time 4 ifconfig.me 2>/dev/null || curl -s --max-time 4 api.ipify.org 2>/dev/null || echo "Unavailable/Offline")
    echo -e "  ${C_GREEN}●${C_RESET} ${C_WHITE}Public WAN IP:${C_RESET}   ${C_MAGENTA}${wan_ip}${C_RESET}\n"

    echo -e "${C_CYAN}[*] Active Interfaces:${C_RESET}"
    ip -br addr show 2>/dev/null || ifconfig -s 2>/dev/null || true
    echo ""
}

cmd_ports() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX Listening Sockets & Ports Audit:${C_RESET}\n"
    if command -v ss >/dev/null 2>&1; then
        ss -tulpn
    elif command -v netstat >/dev/null 2>&1; then
        netstat -tulpn
    elif command -v lsof >/dev/null 2>&1; then
        lsof -i -P -n | grep LISTEN
    else
        echo -e "${C_RED}[!] No socket inspection tool (ss, netstat, lsof) found.${C_RESET}"
    fi
}

cmd_ping() {
    local target="${1:-1.1.1.1}"
    echo -e "${C_CYAN}${C_BOLD}[*] Cybernetic ICMP Latency Probe » ${C_YELLOW}${target}${C_RESET}..."
    ping -c 4 "$target"
}

cmd_scan() {
    if [ -z "$1" ]; then
        echo -e "${C_RED}[!] Error: Target IP/host required.${C_RESET}\n${C_YELLOW}Usage:${C_RESET} ax scan <target>"
        exit 1
    fi
    if command -v nmap >/dev/null 2>&1; then
        echo -e "${C_CYAN}${C_BOLD}[*] Launching Nmap Rapid Service Probe on ${1}...${C_RESET}"
        nmap -sV -sC -T4 "$@"
    else
        if run_native_bin "asterix-netprobe" "$@"; then
            return 0
        fi
        echo -e "${C_YELLOW}[!] nmap not found. Running basic ping check...${C_RESET}"
        ping -c 3 "$1"
    fi
}

cmd_netrecon() {
    local script
    script=$(find_helper_script "net-recon.sh")
    if [ -n "$script" ]; then
        bash "$script" "$@"
    else
        echo -e "${C_RED}[!] net-recon.sh not found.${C_RESET}"
    fi
}

cmd_mac() {
    local iface="$1"
    if [ -z "$iface" ]; then
        iface=$(ip route show default 2>/dev/null | awk '{print $5}' || echo "eth0")
    fi
    echo -e "${C_CYAN}${C_BOLD}[*] MAC Address Control on interface:${C_RESET} ${C_YELLOW}${iface}${C_RESET}"
    if command -v macchanger >/dev/null 2>&1; then
        echo -e "${C_YELLOW}[*] Generating randomized cyber MAC address...${C_RESET}"
        run_as_root macchanger -r "$iface"
    else
        echo -e "${C_WHITE}Current Hardware Address:${C_RESET}"
        ip link show "$iface" 2>/dev/null | grep -o "link/ether .*" || echo "Interface not found"
        echo -e "${C_GRAY}[i] Install macchanger for automatic spoofing (ax install macchanger)${C_RESET}"
    fi
}

cmd_webrecon() {
    if run_native_bin "asterix-webrecon" "$@"; then
        return 0
    fi
    echo -e "${C_YELLOW}[!] asterix-webrecon not built. Run 'ax build' to compile.${C_RESET}"
}

cmd_dns() {
    local domain="${1:-google.com}"
    echo -e "${C_CYAN}${C_BOLD}[*] DNS Resolution & MX Records for:${C_RESET} ${C_YELLOW}${domain}${C_RESET}"
    if command -v dig >/dev/null 2>&1; then
        dig +short A "$domain"
        dig +short MX "$domain"
        dig +short TXT "$domain"
    elif command -v host >/dev/null 2>&1; then
        host "$domain"
    elif command -v nslookup >/dev/null 2>&1; then
        nslookup "$domain"
    else
        getent hosts "$domain"
    fi
}

cmd_whois() {
    if [ -z "$1" ]; then
        echo -e "${C_RED}[!] Error: Domain or IP target required.${C_RESET}\n${C_YELLOW}Usage:${C_RESET} ax whois <target>"
        exit 1
    fi
    if command -v whois >/dev/null 2>&1; then
        whois "$@"
    else
        echo -e "${C_YELLOW}[!] whois not installed. Install with: ax install whois${C_RESET}"
    fi
}

cmd_traceroute() {
    local target="${1:-1.1.1.1}"
    echo -e "${C_CYAN}${C_BOLD}[*] Tracing network route to ${target}...${C_RESET}"
    if command -v traceroute >/dev/null 2>&1; then
        traceroute -m 20 "$target"
    elif command -v tracepath >/dev/null 2>&1; then
        tracepath "$target"
    else
        echo -e "${C_YELLOW}[!] traceroute/tracepath not installed.${C_RESET}"
    fi
}

cmd_arp() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX Local ARP Cache Table:${C_RESET}\n"
    ip neigh show 2>/dev/null || arp -a 2>/dev/null || cat /proc/net/arp
}

cmd_connections() {
    echo -e "${C_CYAN}${C_BOLD}[*] Active Established External Connections:${C_RESET}\n"
    ss -tupn state established 2>/dev/null || netstat -an | grep ESTABLISHED
}

# ---------------------------------------------------------------------
# 3. Security, Cryptography & Defense
# ---------------------------------------------------------------------

cmd_hash() {
    if [ -z "$1" ]; then
        echo -e "${C_RED}[!] Error: File or text required to hash.${C_RESET}\n${C_YELLOW}Usage:${C_RESET} ax hash <file>"
        exit 1
    fi
    if run_native_bin "asterix-hasher" "$@"; then
        return 0
    fi
    local target="$1"
    if [ -f "$target" ]; then
        echo -e "${C_CYAN}${C_BOLD}[*] Calculating Checksums for:${C_RESET} ${C_WHITE}${target}${C_RESET}"
        echo -e "  ${C_CYAN}MD5:    ${C_RESET}$(md5sum "$target" 2>/dev/null | awk '{print $1}')"
        echo -e "  ${C_GREEN}SHA1:   ${C_RESET}$(sha1sum "$target" 2>/dev/null | awk '{print $1}')"
        echo -e "  ${C_YELLOW}SHA256: ${C_RESET}$(sha256sum "$target" 2>/dev/null | awk '{print $1}')"
        echo -e "  ${C_MAGENTA}SHA512: ${C_RESET}$(sha512sum "$target" 2>/dev/null | awk '{print $1}')"
    else
        echo -e "${C_CYAN}${C_BOLD}[*] Calculating Checksum for String:${C_RESET}"
        echo -n "$target" | sha256sum | awk '{print "  SHA256: " $1}'
    fi
}

cmd_shred() {
    if [ -z "$1" ]; then
        echo -e "${C_RED}[!] Error: File target required to shred.${C_RESET}\n${C_YELLOW}Usage:${C_RESET} ax shred <file>"
        exit 1
    fi
    if run_native_bin "asterix-shredder" "$@"; then
        return 0
    fi
    echo -e "${C_RED}${C_BOLD}[*] Performing Multi-Pass Cryptographic Wipe on:${C_RESET} ${C_WHITE}${1}${C_RESET}"
    if command -v shred >/dev/null 2>&1; then
        shred -u -z -n 3 "$1"
        echo -e "${C_GREEN}[✔] File permanently obliterated.${C_RESET}"
    else
        rm -f "$1"
        echo -e "${C_YELLOW}[✔] File unlinked.${C_RESET}"
    fi
}

cmd_rootkit() {
    if run_native_bin "asterix-rootkit-detect"; then
        return 0
    fi
    echo -e "${C_CYAN}${C_BOLD}[*] Performing Rootkit & Anomaly Scan...${C_RESET}"
    if command -v chkrootkit >/dev/null 2>&1; then
        run_as_root chkrootkit
    else
        echo -e "${C_GRAY}[*] Checking hidden processes in /proc...${C_RESET}"
        ps -ef | grep -E "\[.*\]" | head -n 15
        echo -e "${C_GREEN}[✔] Basic kernel checks completed.${C_RESET}"
    fi
}

cmd_trace() {
    if run_native_bin "asterix-syscall-mon" "$@"; then
        return 0
    fi
    if [ -n "$1" ]; then
        echo -e "${C_CYAN}[*] Tracing syscalls for PID/Target ${1}...${C_RESET}"
        strace -c -p "$1" 2>/dev/null || strace "$@"
    else
        echo -e "${C_YELLOW}Usage:${C_RESET} ax trace <pid or command>"
    fi
}

cmd_packet() {
    if run_native_bin "asterix-packetcraft" "$@"; then
        return 0
    fi
    echo -e "${C_YELLOW}[!] asterix-packetcraft utility not built. Run 'ax build' to compile.${C_RESET}"
}

cmd_vuln() {
    if run_native_bin "asterix-vulnscan" "$@"; then
        return 0
    fi
    echo -e "${C_YELLOW}[!] asterix-vulnscan utility not built. Run 'ax build' to compile.${C_RESET}"
}

cmd_logwatch() {
    if run_native_bin "asterix-logwatch" "$@"; then
        return 0
    fi
    echo -e "${C_CYAN}[*] Streaming security auth log...${C_RESET}"
    tail -f /var/log/auth.log 2>/dev/null || tail -f /var/log/syslog 2>/dev/null || dmesg -w
}

cmd_firewall() {
    echo -e "${C_CYAN}${C_BOLD}[*] ASTERIX Firewall & Packet Filtering Status:${C_RESET}\n"
    if command -v ufw >/dev/null 2>&1; then
        run_as_root ufw status verbose
    elif command -v iptables >/dev/null 2>&1; then
        run_as_root iptables -L -n -v --line-numbers
    elif command -v nft >/dev/null 2>&1; then
        run_as_root nft list ruleset
    else
        echo -e "${C_YELLOW}[!] No firewall utility (ufw/iptables/nft) found.${C_RESET}"
    fi
}

cmd_audit() {
    echo -e "${C_CYAN}${C_BOLD}[*] Running ASTERIX Security & Hardening Audit...${C_RESET}\n"
    if command -v lynis >/dev/null 2>&1; then
        run_as_root lynis audit system --quick
    else
        echo -e "${C_YELLOW}[*] Performing Quick Linux Permission & Hardening Check...${C_RESET}"
        echo -e "  [1] World-Writable Files in /etc:"
        find /etc -maxdepth 2 -perm -o+w 2>/dev/null || echo "None found"
        echo -e "  [2] Unowned Files:"
        find / -nouser 2>/dev/null | head -n 10 || echo "None found"
        echo -e "\n${C_GREEN}[✔] Basic security check done.${C_RESET}"
    fi
}

cmd_bin_inspect() {
    if run_native_bin "asterix-bin-inspector" "$@"; then
        return 0
    fi
    echo -e "${C_YELLOW}[!] asterix-bin-inspector not yet compiled.${C_RESET}"
    echo -e "${C_CYAN}[*] Running fallback objdump / file analysis:${C_RESET}"
    if [ -n "$1" ]; then
        file "$1" 2>/dev/null || true
        objdump -f "$1" 2>/dev/null || true
    fi
}

cmd_sentinel() {
    if run_native_bin "asterix-net-sentinel" "$@"; then
        return 0
    fi
    echo -e "${C_YELLOW}[!] asterix-net-sentinel not yet compiled.${C_RESET}"
    echo -e "${C_CYAN}[*] Running fast fallback network probe:${C_RESET}"
    local host="${1:-127.0.0.1}"
    nc -zv -w 1 "$host" 21 22 80 443 8080 2>&1 || true
}

cmd_crypto() {
    if run_native_bin "asterix-crypto-core" "$@"; then
        return 0
    fi
    echo -e "${C_YELLOW}[!] asterix-crypto-core not yet compiled.${C_RESET}"
    echo -e "${C_CYAN}[*] Running sha256sum / md5sum fallback:${C_RESET}"
    if [ -f "$1" ]; then
        sha256sum "$1" 2>/dev/null || md5sum "$1" 2>/dev/null || true
    fi
}

cmd_cipher() {
    if run_native_bin "asterix-cipher-asm" "$@"; then
        return 0
    elif run_native_bin "asterix-crypto-core" "$@"; then
        return 0
    fi
    echo -e "${C_YELLOW}[!] asterix-cipher-asm or asterix-crypto-core not built. Run 'ax build' to compile.${C_RESET}"
}

cmd_sysmon() {
    if run_native_bin "asterix-sys-mon" "$@"; then
        return 0
    fi
    echo -e "${C_YELLOW}[!] asterix-sys-mon not yet compiled.${C_RESET}"
    if command -v btop >/dev/null 2>&1; then
        exec btop
    elif command -v htop >/dev/null 2>&1; then
        exec htop
    else
        exec top
    fi
}

cmd_guard() {
    if run_native_bin "asterix-guard-engine" "$@"; then
        return 0
    fi
    echo -e "${C_YELLOW}[!] asterix-guard-engine not yet compiled. Running native audit fallback...${C_RESET}"
    cmd_audit "$@"
}

