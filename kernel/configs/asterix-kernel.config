# ASTERIX OS custom kernel config
# This is a minimal security-oriented starting point for a live ISO build.
CONFIG_LOCALVERSION="-asterix"
CONFIG_DEFAULT_HOSTNAME="asterix"
CONFIG_KERNEL_XZ=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_BPF_SYSCALL=y
CONFIG_PREEMPT=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_SMP=y
CONFIG_HOTPLUG_CPU=y
CONFIG_SCHED_MC=y
CONFIG_X86_64=y
CONFIG_64BIT=y
CONFIG_NR_CPUS=64
CONFIG_NUMA_BALANCING=y
CONFIG_ZSWAP=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_COREDUMP=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_RANDOM=y
CONFIG_UEFI_STUB=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_FIRMWARE_IN_KERNEL=y
CONFIG_FW_LOADER=y
CONFIG_PM=y
