[Desktop Entry]
Version=1.0
Type=Application
Name=ASTERIX Terminal Studio (Tmux)
GenericName=Multi-Terminal Multiplexer
Comment=High-performance terminal workspace with mouse scrolling and live pane splitting
Exec=x-terminal-emulator -T "ASTERIX TERMINAL STUDIO" -e "tmux -f /etc/asterix/asterix.tmux.conf"
Icon=utilities-terminal
Terminal=false
Categories=System;TerminalEmulator;
StartupNotify=true
Keywords=terminal;tmux;console;split;scroll;
